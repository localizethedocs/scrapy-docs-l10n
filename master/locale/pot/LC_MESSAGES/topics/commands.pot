#: ../../../topics/commands.rst:225 ../../../topics/commands.rst:241
#: ../../../topics/commands.rst:421 ../../../topics/commands.rst:469
#: ../../../topics/commands.rst:492 ../../../topics/commands.rst:597
#: ../../../topics/commands.rst:617 ../../../topics/commands.rst:634
#: ../../../topics/commands.rst:645
msgid "Requires project: *no*"
msgstr ""

#: ../../../topics/commands.rst:227
msgid ""
"Creates a new Scrapy project named ``project_name``, under the "
"``project_dir`` directory. If ``project_dir`` wasn't specified, "
"``project_dir`` will be the same as ``project_name``."
msgstr ""

#: ../../../topics/commands.rst:231 ../../../topics/commands.rst:245
#: ../../../topics/commands.rst:390 ../../../topics/commands.rst:411
#: ../../../topics/commands.rst:481 ../../../topics/commands.rst:509
#: ../../../topics/commands.rst:574
msgid "Usage example::"

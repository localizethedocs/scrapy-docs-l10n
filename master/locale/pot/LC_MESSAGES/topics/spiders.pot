#: ../../../topics/spiders.rst:5
msgid "Spiders"
msgstr ""

#: ../../../topics/spiders.rst:7
msgid ""
"Spiders are classes that define how a site, or a group of sites, is scraped: "
"which requests to send, and how to parse their responses to extract data and "
"to send additional requests."
msgstr ""

#: ../../../topics/spiders.rst:11
msgid "A crawl goes as follows:"
msgstr ""

#: ../../../topics/spiders.rst:13
msgid ""
"Scrapy iterates the :meth:`~scrapy.Spider.start` method of the spider to get "
"the initial requests. By default, that method yields a :class:`~scrapy."
"Request` object for each URL in :attr:`~scrapy.Spider.start_urls`, with :"
"meth:`~scrapy.Spider.parse` as :ref:`callback <callbacks>`."
msgstr ""

#: ../../../topics/spiders.rst:19
msgid ""
"Scrapy downloads each request and calls its callback with the resulting :"
"class:`~scrapy.http.Response`."
msgstr ""

#: ../../../topics/spiders.rst:22
msgid ""
"Callbacks parse the response, typically using :ref:`topics-selectors`, and "
"return or yield :ref:`item objects <topics-items>` with the extracted data "
"and :class:`~scrapy.Request` objects to continue the crawl, which go back to "
"step 2. See :ref:`callback-output`."
msgstr ""

#: ../../../topics/spiders.rst:27
msgid ""
"Items go through :ref:`item pipelines <topics-item-pipeline>`, and are "
"usually stored through :ref:`topics-feed-exports`."
msgstr ""

#: ../../../topics/spiders.rst:30
msgid ""
"Scrapy includes different spider classes for different purposes, described "
"below."
msgstr ""

#: ../../../topics/spiders.rst:36
msgid "scrapy.Spider"
msgstr ""

#: ../../../topics/spiders.rst:69
msgid "Let's see an example:"
msgstr ""

#: ../../../topics/spiders.rst:71
msgid ""
"import scrapy\n"
"\n"
"\n"
"class MySpider(scrapy.Spider):\n"
"    name = \"example.com\"\n"
"    allowed_domains = [\"example.com\"]\n"
"    start_urls = [\n"
"        \"http://www.example.com/1.html\",\n"
"        \"http://www.example.com/2.html\",\n"
"        \"http://www.example.com/3.html\",\n"
"    ]\n"
"\n"
"    def parse(self, response):\n"
"        self.logger.info(\"A response from %s just arrived!\", response.url)"
msgstr ""

#: ../../../topics/spiders.rst:88
msgid "Return multiple Requests and items from a single callback:"
msgstr ""

#: ../../../topics/spiders.rst:90
msgid ""
"import scrapy\n"
"\n"
"\n"
"class MySpider(scrapy.Spider):\n"
"    name = \"example.com\"\n"
"    allowed_domains = [\"example.com\"]\n"
"    start_urls = [\n"
"        \"http://www.example.com/1.html\",\n"
"        \"http://www.example.com/2.html\",\n"
"        \"http://www.example.com/3.html\",\n"
"    ]\n"
"\n"
"    def parse(self, response):\n"
"        for h3 in response.xpath(\"//h3\").getall():\n"
"            yield {\"title\": h3}\n"
"\n"
"        for href in response.xpath(\"//a/@href\").getall():\n"
"            yield scrapy.Request(response.urljoin(href), self.parse)"
msgstr ""

#: ../../../topics/spiders.rst:111
msgid ""
"Instead of :attr:`~.start_urls` you can use :meth:`~scrapy.Spider.start` "
"directly; to give data more structure you can use :class:`~scrapy.Item` "
"objects:"
msgstr ""

#: ../../../topics/spiders.rst:116
msgid ""
"import scrapy\n"
"from myproject.items import MyItem\n"
"\n"
"\n"
"class MySpider(scrapy.Spider):\n"
"    name = \"example.com\"\n"
"    allowed_domains = [\"example.com\"]\n"
"\n"
"    async def start(self):\n"
"        yield scrapy.Request(\"http://www.example.com/1.html\", self.parse)\n"
"        yield scrapy.Request(\"http://www.example.com/2.html\", self.parse)\n"
"        yield scrapy.Request(\"http://www.example.com/3.html\", self.parse)\n"
"\n"
"    def parse(self, response):\n"
"        for h3 in response.xpath(\"//h3\").getall():\n"
"            yield MyItem(title=h3)\n"
"\n"
"        for href in response.xpath(\"//a/@href\").getall():\n"
"            yield scrapy.Request(response.urljoin(href), self.parse)"
msgstr ""

#: ../../../topics/spiders.rst:141
msgid "Spider arguments"
msgstr ""

#: ../../../topics/spiders.rst:143
msgid ""
"Spiders can receive arguments that modify their behaviour. Some common uses "
"for spider arguments are to define the start URLs or to restrict the crawl "
"to certain sections of the site, but they can be used to configure any "
"functionality of the spider."
msgstr ""

#: ../../../topics/spiders.rst:148
msgid ""
"Spider arguments are passed through the :command:`crawl` command using the "
"``-a`` option. For example::"
msgstr ""

#: ../../../topics/spiders.rst:151
msgid "scrapy crawl myspider -a category=electronics"
msgstr ""

#: ../../../topics/spiders.rst:153
msgid "Spiders can access arguments in their `__init__` methods:"
msgstr ""

#: ../../../topics/spiders.rst:155
msgid ""
"import scrapy\n"
"\n"
"\n"
"class MySpider(scrapy.Spider):\n"
"    name = \"myspider\"\n"
"\n"
"    def __init__(self, category=None, *args, **kwargs):\n"
"        super().__init__(*args, **kwargs)\n"
"        self.start_urls = [f\"http://www.example.com/categories/"
"{category}\"]\n"
"        # ..."
msgstr ""

#: ../../../topics/spiders.rst:168
msgid ""
"The default ``__init__`` method will take any spider arguments and copy them "
"to the spider as attributes. The above example can also be written as "
"follows:"
msgstr ""

#: ../../../topics/spiders.rst:171
msgid ""
"import scrapy\n"
"\n"
"\n"
"class MySpider(scrapy.Spider):\n"
"    name = \"myspider\"\n"
"\n"
"    async def start(self):\n"
"        yield scrapy.Request(f\"http://www.example.com/categories/{self."
"category}\")"
msgstr ""

#: ../../../topics/spiders.rst:182
msgid ""
"If you are :ref:`running Scrapy from a script <run-from-script>`, you can "
"specify spider arguments when calling :meth:`CrawlerProcess.crawl <scrapy."
"crawler.CrawlerProcess.crawl>` or :meth:`CrawlerRunner.crawl <scrapy.crawler."
"CrawlerRunner.crawl>`:"
msgstr ""

#: ../../../topics/spiders.rst:188
msgid ""
"process = CrawlerProcess()\n"
"process.crawl(MySpider, category=\"electronics\")"
msgstr ""

#: ../../../topics/spiders.rst:193
msgid ""
"Keep in mind that spider arguments are only strings. The spider will not do "
"any parsing on its own. If you were to set the ``start_urls`` attribute from "
"the command line, you would have to parse it on your own into a list using "
"something like :func:`ast.literal_eval` or :func:`json.loads` and then set "
"it as an attribute. Otherwise, you would cause iteration over a "
"``start_urls`` string (a very common Python pitfall) resulting in each "
"character being seen as a separate url."
msgstr ""

#: ../../../topics/spiders.rst:201
msgid ""
"Spider arguments can also be passed through the Scrapyd ``schedule.json`` "
"API. See `Scrapyd documentation`_."
msgstr ""

#: ../../../topics/spiders.rst:207
msgid "scrapy-spider-metadata parameters"
msgstr ""

#: ../../../topics/spiders.rst:209
msgid ""
"Another alternative to pass spider arguments is the library `scrapy-spider-"
"metadata`_."
msgstr ""

#: ../../../topics/spiders.rst:211
msgid ""
"This allows for Scrapy spiders to define, validate, document and pre-process "
"their arguments as Pydantic models."
msgstr ""

#: ../../../topics/spiders.rst:214
msgid ""
"The example shows how to define typed parameters where a string argument is "
"automatically converted to an integer:"
msgstr ""

#: ../../../topics/spiders.rst:217
msgid ""
"import scrapy\n"
"from pydantic import BaseModel\n"
"from scrapy_spider_metadata import Args\n"
"\n"
"\n"
"class MyParams(BaseModel):\n"
"    pages: int\n"
"\n"
"\n"
"class BookSpider(Args[MyParams], scrapy.Spider):\n"
"    name = \"bookspider\"\n"
"    start_urls = [\"http://books.toscrape.com/catalogue\"]\n"
"\n"
"    async def start(self):\n"
"        for start_url in self.start_urls:\n"
"            for index in range(1, self.args.pages + 1):\n"
"                yield scrapy.Request(f\"{start_url}/page-{index}.html\")\n"
"\n"
"    def parse(self, response):\n"
"        book_links = response.css(\"article.product_pod h3 a::attr(href)\")."
"getall()\n"
"        for book_link in book_links:\n"
"            yield response.follow(book_link, self.parse_book)\n"
"\n"
"    def parse_book(self, response):\n"
"        yield {\n"
"            \"title\": response.css(\"h1::text\").get(),\n"
"            \"price\": response.css(\"p.price_color::text\").get(),\n"
"        }"
msgstr ""

#: ../../../topics/spiders.rst:248
msgid "This spider can be called from the command line::"
msgstr ""

#: ../../../topics/spiders.rst:250
msgid "scrapy crawl bookspider -a pages=2"
msgstr ""

#: ../../../topics/spiders.rst:255
msgid "Start requests"
msgstr ""

#: ../../../topics/spiders.rst:257
msgid ""
"**Start requests** are :class:`~scrapy.Request` objects yielded from the :"
"meth:`~scrapy.Spider.start` method of a spider or from the :meth:`~scrapy."
"spidermiddlewares.SpiderMiddleware.process_start` method of a :ref:`spider "
"middleware <topics-spider-middleware>`."
msgstr ""

#: ../../../topics/spiders.rst:262
msgid ":ref:`start-request-order`"
msgstr ""

#: ../../../topics/spiders.rst:267
msgid "Delaying start request iteration"
msgstr ""

#: ../../../topics/spiders.rst:269
msgid ""
"Scrapy iterates :meth:`~scrapy.Spider.start` as fast as it yields, so all "
"start requests reach the scheduler early in the crawl, however many they "
"are. To minimize the number of requests in the scheduler at any given time, "
"and with it resource usage (memory, or disk when using :setting:`JOBDIR`), "
"override :meth:`~scrapy.Spider.start` to pause its iteration whenever there "
"are scheduled requests:"
msgstr ""

#: ../../../topics/spiders.rst:276
msgid ""
"async def start(self):\n"
"    async for item_or_request in super().start():\n"
"        if self.crawler.engine.needs_backout():\n"
"            await self.crawler.signals.wait_for(signals.scheduler_empty)\n"
"        yield item_or_request"
msgstr ""

#: ../../../topics/spiders.rst:287
msgid "Handling start errors"
msgstr ""

#: ../../../topics/spiders.rst:289
msgid ""
"An exception raised by :meth:`~scrapy.Spider.start` ends its iteration, so "
"any remaining start items and requests are never sent. Scrapy logs the "
"exception, sends the :signal:`spider_error` signal, and, once the already "
"scheduled requests are done, closes the spider with the ``start_error`` :"
"stat:`finish_reason`."
msgstr ""

#: ../../../topics/spiders.rst:295
msgid ""
"The close reason used to be ``finished``, and neither the :signal:"
"`spider_error` signal nor the :stat:`spider_exceptions/count` stat reported "
"the exception."
msgstr ""

#: ../../../topics/spiders.rst:300
msgid "To keep the iteration going, catch the exception yourself:"
msgstr ""

#: ../../../topics/spiders.rst:302
msgid ""
"async def start(self):\n"
"    for url in self.start_urls:\n"
"        try:\n"
"            request = Request(url)\n"
"        except ValueError:\n"
"            self.logger.exception(f\"Skipping start URL {url}\")\n"
"        else:\n"
"            yield request"
msgstr ""

#: ../../../topics/spiders.rst:313
msgid ""
"To stop the crawl instead, and choose your own :stat:`finish_reason`, raise :"
"exc:`~scrapy.exceptions.CloseSpider`."
msgstr ""

#: ../../../topics/spiders.rst:319
msgid "Generic Spiders"
msgstr ""

#: ../../../topics/spiders.rst:321
msgid ""
"Scrapy comes with some useful generic spiders that you can use to subclass "
"your spiders from. Their aim is to provide convenient functionality for a "
"few common scraping cases, like following all links on a site based on "
"certain rules, crawling from `Sitemaps`_, or parsing an XML/CSV feed."
msgstr ""

#: ../../../topics/spiders.rst:326
msgid ""
"For the examples used in the following spiders, we'll assume you have a "
"project with a ``TestItem`` declared in a ``myproject.items`` module:"
msgstr ""

#: ../../../topics/spiders.rst:329
msgid ""
"from dataclasses import dataclass\n"
"\n"
"\n"
"@dataclass\n"
"class TestItem:\n"
"    id: str | None = None\n"
"    name: str | None = None\n"
"    description: str | None = None"
msgstr ""

#: ../../../topics/spiders.rst:344
msgid "CrawlSpider"
msgstr ""

#: ../../../topics/spiders.rst:351
msgid "Crawling rules"
msgstr ""

#: ../../../topics/spiders.rst:358
msgid "CrawlSpider example"
msgstr ""

#: ../../../topics/spiders.rst:360
msgid "Let's now take a look at an example CrawlSpider with rules:"
msgstr ""

#: ../../../topics/spiders.rst:362
msgid ""
"from scrapy.spiders import CrawlSpider, Rule\n"
"from scrapy.linkextractors import LinkExtractor\n"
"\n"
"\n"
"class MySpider(CrawlSpider):\n"
"    name = \"example.com\"\n"
"    allowed_domains = [\"example.com\"]\n"
"    start_urls = [\"http://www.example.com\"]\n"
"\n"
"    rules = (\n"
"        # Extract links matching 'category.php' (but not matching "
"'subsection.php')\n"
"        # and follow links from them (since no callback means follow=True by "
"default).\n"
"        Rule(LinkExtractor(allow=(r\"category\\.php\",), "
"deny=(r\"subsection\\.php\",))),\n"
"        # Extract links matching 'item.php' and parse them with the spider's "
"method parse_item\n"
"        Rule(LinkExtractor(allow=(r\"item\\.php\",)), "
"callback=\"parse_item\"),\n"
"    )\n"
"\n"
"    def parse_item(self, response):\n"
"        self.logger.info(\"Hi, this is an item page! %s\", response.url)\n"
"        item = {}\n"
"        item[\"id\"] = response.xpath('//td[@id=\"item_id\"]/text()')."
"re(r\"ID: (\\d+)\")\n"
"        item[\"name\"] = response.xpath('//td[@id=\"item_name\"]/text()')."
"get()\n"
"        item[\"description\"] = response.xpath(\n"
"            '//td[@id=\"item_description\"]/text()'\n"
"        ).get()\n"
"        item[\"link_text\"] = response.meta[\"link_text\"]\n"
"        url = response.xpath('//td[@id=\"additional_data\"]/@href').get()\n"
"        return response.follow(\n"
"            url, self.parse_additional_page, cb_kwargs=dict(item=item)\n"
"        )\n"
"\n"
"    def parse_additional_page(self, response, item):\n"
"        item[\"additional_data\"] = response.xpath(\n"
"            '//p[@id=\"additional_data\"]/text()'\n"
"        ).get()\n"
"        return item"
msgstr ""

#: ../../../topics/spiders.rst:402
msgid ""
"This spider would start crawling example.com's home page, collecting "
"category links, and item links, parsing the latter with the ``parse_item`` "
"method. For each item response, some data will be extracted from the HTML "
"using XPath, and a dictionary will be filled with it."
msgstr ""

#: ../../../topics/spiders.rst:408
msgid "XMLFeedSpider"
msgstr ""

#: ../../../topics/spiders.rst:416
msgid "XMLFeedSpider example"
msgstr ""

#: ../../../topics/spiders.rst:418
msgid "These spiders are pretty easy to use, let's have a look at one example:"
msgstr ""

#: ../../../topics/spiders.rst:421
msgid ""
"from scrapy.spiders import XMLFeedSpider\n"
"from myproject.items import TestItem\n"
"\n"
"\n"
"class MySpider(XMLFeedSpider):\n"
"    name = \"example.com\"\n"
"    allowed_domains = [\"example.com\"]\n"
"    start_urls = [\"http://www.example.com/feed.xml\"]\n"
"    iterator = \"iternodes\"  # This is actually unnecessary, since it's the "
"default value\n"
"    itertag = \"item\"\n"
"\n"
"    def parse_node(self, response, node):\n"
"        self.logger.info(\n"
"            \"Hi, this is a <%s> node!: %s\", self.itertag, \"\".join(node."
"getall())\n"
"        )\n"
"\n"
"        item = TestItem()\n"
"        item.id = node.xpath(\"@id\").get()\n"
"        item.name = node.xpath(\"name\").get()\n"
"        item.description = node.xpath(\"description\").get()\n"
"        return item"
msgstr ""

#: ../../../topics/spiders.rst:445
msgid ""
"Basically what we did up there was to create a spider that downloads a feed "
"from the given ``start_urls``, and then iterates through each of its "
"``item`` tags, prints them out, and stores some random data in an :class:"
"`~scrapy.Item`."
msgstr ""

#: ../../../topics/spiders.rst:450
msgid "CSVFeedSpider"
msgstr ""

#: ../../../topics/spiders.rst:456
msgid "CSVFeedSpider example"
msgstr ""

#: ../../../topics/spiders.rst:458
msgid ""
"Let's see an example similar to the previous one, but using a :class:"
"`CSVFeedSpider`:"
msgstr ""

#: ../../../topics/spiders.rst:462
msgid ""
"from scrapy.spiders import CSVFeedSpider\n"
"from myproject.items import TestItem\n"
"\n"
"\n"
"class MySpider(CSVFeedSpider):\n"
"    name = \"example.com\"\n"
"    allowed_domains = [\"example.com\"]\n"
"    start_urls = [\"http://www.example.com/feed.csv\"]\n"
"    delimiter = \";\"\n"
"    quotechar = \"'\"\n"
"    headers = [\"id\", \"name\", \"description\"]\n"
"\n"
"    def parse_row(self, response, row):\n"
"        self.logger.info(\"Hi, this is a row!: %r\", row)\n"
"\n"
"        item = TestItem()\n"
"        item.id = row[\"id\"]\n"
"        item.name = row[\"name\"]\n"
"        item.description = row[\"description\"]\n"
"        return item"
msgstr ""

#: ../../../topics/spiders.rst:487
msgid "SitemapSpider"
msgstr ""

#: ../../../topics/spiders.rst:495
msgid "SitemapSpider examples"
msgstr ""

#: ../../../topics/spiders.rst:497
msgid ""
"Simplest example: process all urls discovered through sitemaps using the "
"``parse`` callback:"
msgstr ""

#: ../../../topics/spiders.rst:500
msgid ""
"from scrapy.spiders import SitemapSpider\n"
"\n"
"\n"
"class MySpider(SitemapSpider):\n"
"    sitemap_urls = [\"http://www.example.com/sitemap.xml\"]\n"
"\n"
"    def parse(self, response):\n"
"        pass  # ... scrape item here ..."
msgstr ""

#: ../../../topics/spiders.rst:511
msgid ""
"Process some urls with certain callback and other urls with a different "
"callback:"
msgstr ""

#: ../../../topics/spiders.rst:514
msgid ""
"from scrapy.spiders import SitemapSpider\n"
"\n"
"\n"
"class MySpider(SitemapSpider):\n"
"    sitemap_urls = [\"http://www.example.com/sitemap.xml\"]\n"
"    sitemap_rules = [\n"
"        (\"/product/\", \"parse_product\"),\n"
"        (\"/category/\", \"parse_category\"),\n"
"    ]\n"
"\n"
"    def parse_product(self, response):\n"
"        pass  # ... scrape product ...\n"
"\n"
"    def parse_category(self, response):\n"
"        pass  # ... scrape category ..."
msgstr ""

#: ../../../topics/spiders.rst:532
msgid ""
"Follow sitemaps defined in the `robots.txt`_ file and only follow sitemaps "
"whose url contains ``/sitemap_shop``:"
msgstr ""

#: ../../../topics/spiders.rst:535
msgid ""
"from scrapy.spiders import SitemapSpider\n"
"\n"
"\n"
"class MySpider(SitemapSpider):\n"
"    sitemap_urls = [\"http://www.example.com/robots.txt\"]\n"
"    sitemap_rules = [\n"
"        (\"/shop/\", \"parse_shop\"),\n"
"    ]\n"
"    sitemap_follow = [\"/sitemap_shops\"]\n"
"\n"
"    def parse_shop(self, response):\n"
"        pass  # ... scrape shop here ..."
msgstr ""

#: ../../../topics/spiders.rst:550
msgid "Combine SitemapSpider with other sources of urls:"
msgstr ""

#: ../../../topics/spiders.rst:552
msgid ""
"from scrapy import Request\n"
"from scrapy.spiders import SitemapSpider\n"
"\n"
"\n"
"class MySpider(SitemapSpider):\n"
"    sitemap_urls = [\"http://www.example.com/robots.txt\"]\n"
"    sitemap_rules = [\n"
"        (\"/shop/\", \"parse_shop\"),\n"
"    ]\n"
"\n"
"    other_urls = [\"http://www.example.com/about\"]\n"
"\n"
"    async def start(self):\n"
"        async for item_or_request in super().start():\n"
"            yield item_or_request\n"
"        for url in self.other_urls:\n"
"            yield Request(url, self.parse_other)\n"
"\n"
"    def parse_shop(self, response):\n"
"        pass  # ... scrape shop here ...\n"
"\n"
"    def parse_other(self, response):\n"
"        pass  # ... scrape other here ..."
msgstr ""

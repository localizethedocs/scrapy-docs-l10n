msgid ""
"Works the same way as :meth:`FilesPipeline.item_completed` method, but using "
"a different field names for storing image downloading results."
msgstr ""

#: ../../../topics/media-pipeline.rst:871
msgid "Accessing the response of a failed download"
msgstr ""

#: ../../../topics/media-pipeline.rst:873
msgid ""
"When a download fails, :meth:`~item_completed` receives it as a :exc:"
"`~twisted.python.failure.Failure` whose ``value`` is the exception raised "
"from :meth:`~media_downloaded`. For a non-2xx response, that exception is a :"
"exc:`~scrapy.pipelines.media.FileException` built from just a message, "
"without a reference to the response. To access the response, for example to "
"record its ``status`` on the item, override :meth:`~media_downloaded` to "
"attach it to a custom exception:"
msgstr ""

#: ../../../topics/media-pipeline.rst:881
msgid ""
"from scrapy.pipelines.files import FilesPipeline\n"
"from scrapy.pipelines.media import FileException\n"
"\n"
"\n"
"class ResponseFileException(FileException):\n"
"    def __init__(self, response):\n"
"        super().__init__(f\"download-error ({response.status})\")\n"
"        self.response = response\n"
"\n"
"\n"
"class MyFilesPipeline(FilesPipeline):\n"
"    async def media_downloaded(self, response, request, info, *, "
"item=None):\n"
"        try:\n"
"            return await super().media_downloaded(response, request, info, "
"item=item)\n"
"        except FileException:\n"
"            raise ResponseFileException(response)\n"
"\n"
"    def item_completed(self, results, item, info):\n"
"        errors = [\n"
"            value.value.response.status\n"
"            for ok, value in results\n"
"            if not ok and value.check(ResponseFileException)\n"
"        ]\n"
"        if errors:\n"
"            item[\"download_errors\"] = errors\n"
"        return super().item_completed(results, item, info)"
msgstr ""

#: ../../../topics/media-pipeline.rst:914
msgid "Custom Images pipeline example"
msgstr ""

#: ../../../topics/media-pipeline.rst:916
msgid ""
"Here is a full example of the Images Pipeline whose methods are exemplified "
"above:"
msgstr ""

#: ../../../topics/media-pipeline.rst:919
msgid ""
"import scrapy\n"
"from itemadapter import ItemAdapter\n"
"from scrapy.exceptions import DropItem\n"
"from scrapy.pipelines.images import ImagesPipeline\n"
"\n"
"\n"
"class MyImagesPipeline(ImagesPipeline):\n"
"    def get_media_requests(self, item, info):\n"
"        for image_url in item[\"image_urls\"]:\n"
"            yield scrapy.Request(image_url)\n"
"\n"
"    def item_completed(self, results, item, info):\n"
"        image_paths = [x[\"path\"] for ok, x in results if ok]\n"
"        if not image_paths:\n"
"            raise DropItem(\"Item contains no images\")\n"
"        adapter = ItemAdapter(item)\n"
"        adapter[\"image_paths\"] = image_paths\n"
"        return item"
msgstr ""

#: ../../../topics/media-pipeline.rst:941
msgid ""
"To enable your custom media pipeline component you must add its class import "
"path to the :setting:`ITEM_PIPELINES` setting, like in the following example:"
msgstr ""

#: ../../../topics/media-pipeline.rst:944
msgid "ITEM_PIPELINES = {\"myproject.pipelines.MyImagesPipeline\": 300}"
msgstr ""

#: ../../../topics/media-pipeline.rst:949
msgid "Content-based image filtering pipeline"
msgstr ""

#: ../../../topics/media-pipeline.rst:951
msgid ""
"This example overrides ``get_images()`` to filter images using a classifier, "
"such as a TensorFlow_ model. Override ``is_valid_image()`` with your "
"classification logic:"
msgstr ""

#: ../../../topics/media-pipeline.rst:955
msgid ""
"from scrapy.pipelines.images import ImagesPipeline, ImageException\n"
"\n"
"\n"
"class ImageClassifierPipeline(ImagesPipeline):\n"
"    def is_valid_image(self, image):\n"
"        raise NotImplementedError\n"
"\n"
"    def get_images(self, response, request, info, *, item=None):\n"
"        for path, image, buf in super().get_images(response, request, info, "
"item=item):\n"
"            if not self.is_valid_image(image):\n"
"                raise ImageException(\"Image does not match criteria\")\n"
"            yield path, image, buf"
msgstr ""

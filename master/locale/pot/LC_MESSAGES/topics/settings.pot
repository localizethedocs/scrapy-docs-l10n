msgstr ""

#: ../../../topics/settings.rst:1649
msgid "Default: ``'utf-8'``"
msgstr ""

#: ../../../topics/settings.rst:1651
msgid "The encoding to use for logging."
msgstr ""

#: ../../../topics/settings.rst:1658
msgid "LOG_FILE"
msgstr ""

#: ../../../topics/settings.rst:1662
msgid ""

msgstr ""

#: ../../../topics/settings.rst:1812 ../../../topics/settings.rst:1828
#: ../../../topics/settings.rst:1843 ../../../topics/settings.rst:1861
msgid "Scope: ``scrapy.extensions.memusage.MemoryUsage``"
msgstr ""

#: ../../../topics/settings.rst:1814
msgid ""
"Whether to enable the memory usage extension. This extension keeps track of "

#: ../../../topics/settings.rst:1708
msgid "LOG_FORMATTER"
msgstr ""

#: ../../../topics/settings.rst:1710
msgid "Default: :class:`scrapy.logformatter.LogFormatter`"
msgstr ""

#: ../../../topics/settings.rst:1712
msgid ""

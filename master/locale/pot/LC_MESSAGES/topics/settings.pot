#: ../../../topics/settings.rst:566
msgid "BOT_NAME"
msgstr ""

#: ../../../topics/settings.rst:568
msgid ""
"Default: ``<project name>`` (:ref:`fallback <default-settings>`: "
"``'scrapybot'``)"
msgstr ""

#: ../../../topics/settings.rst:570
msgid ""
"The name of the bot implemented by this Scrapy project (also known as the "
"project name). This name will be used for the logging too."
msgstr ""

#: ../../../topics/settings.rst:573
msgid ""
"It's automatically populated with your project name when you create your "
"project with the :command:`startproject` command."
msgstr ""

#: ../../../topics/settings.rst:579
msgid "CONCURRENT_ITEMS"
msgstr ""

#: ../../../topics/settings.rst:581
msgid "Default: ``100``"
msgstr ""

#: ../../../topics/settings.rst:583
msgid ""
"Maximum number of concurrent items (per response) to process in parallel in :"
"ref:`item pipelines <topics-item-pipeline>`."
msgstr ""

#: ../../../topics/settings.rst:589
msgid "CONCURRENT_REQUESTS"
msgstr ""

#: ../../../topics/settings.rst:591
msgid "Default: ``16``"
msgstr ""

#: ../../../topics/settings.rst:593
msgid ""
"The maximum number of concurrent (i.e. simultaneous) requests that will be "
"performed by the Scrapy downloader. Use ``0`` for no limit."
msgstr ""

#: ../../../topics/settings.rst:599
msgid "CONCURRENT_REQUESTS_PER_DOMAIN"
msgstr ""

#: ../../../topics/settings.rst:601
msgid "Default: ``1`` (:ref:`fallback <default-settings>`: ``8``)"
msgstr ""

#: ../../../topics/settings.rst:603
msgid ""
"The maximum number of concurrent (i.e. simultaneous) requests that will be "
"performed to any single domain."
msgstr ""

#: ../../../topics/settings.rst:606
msgid ""
"See also: :ref:`topics-autothrottle` and its :setting:"
"`AUTOTHROTTLE_TARGET_CONCURRENCY` option."
msgstr ""

#: ../../../topics/settings.rst:609 ../../../topics/settings.rst:981
#: ../../../topics/settings.rst:1000
msgid ""
"It is possible to change this setting per domain by using :setting:"
"`DOWNLOAD_SLOTS`."
msgstr ""

#: ../../../topics/settings.rst:615
msgid "DEFAULT_DROPITEM_LOG_LEVEL"
msgstr ""

#: ../../../topics/settings.rst:617
msgid "Default: ``\"WARNING\"``"
msgstr ""

#: ../../../topics/settings.rst:619
msgid "Default :ref:`log level <levels>` of messages about dropped items."
msgstr ""

#: ../../../topics/settings.rst:621
msgid ""
"When an item is dropped by raising :exc:`scrapy.exceptions.DropItem` from "
"the :func:`process_item` method of an :ref:`item pipeline <topics-item-"
"pipeline>`, a message is logged, and by default its log level is the one "
"configured in this setting."
msgstr ""

#: ../../../topics/settings.rst:626
msgid ""
"You may specify this log level as an integer (e.g. ``20``), as a log level "
"constant (e.g. ``logging.INFO``) or as a string with the name of a log level "
"constant (e.g. ``\"INFO\"``)."
msgstr ""

#: ../../../topics/settings.rst:630
msgid ""
"When writing an item pipeline, you can force a different log level by "
"setting :attr:`scrapy.exceptions.DropItem.log_level` in your :exc:`scrapy."
"exceptions.DropItem` exception. For example:"
msgstr ""

#: ../../../topics/settings.rst:634
msgid ""
"from scrapy.exceptions import DropItem\n"
"\n"
"\n"
"class MyPipeline:\n"
"    def process_item(self, item):\n"
"        if not item.get(\"price\"):\n"
"            raise DropItem(\"Missing price data\", log_level=\"INFO\")\n"
"        return item"
msgstr ""

#: ../../../topics/settings.rst:648
msgid "DEFAULT_ITEM_CLASS"
msgstr ""

#: ../../../topics/settings.rst:650
msgid "Default: ``'scrapy.item.Item'``"
msgstr ""

#: ../../../topics/settings.rst:652
msgid ""
"The default class that will be used for instantiating items in the :ref:`the "
"Scrapy shell <topics-shell>`."
msgstr ""

#: ../../../topics/settings.rst:658
msgid "DEFAULT_REQUEST_HEADERS"
msgstr ""

#: ../../../topics/settings.rst:660 ../../../topics/settings.rst:912
#: ../../../topics/settings.rst:1063 ../../../topics/settings.rst:1398
#: ../../../topics/settings.rst:2103 ../../../topics/settings.rst:2170
msgid "Default:"
msgstr ""

#: ../../../topics/settings.rst:662
msgid ""
"{\n"
"    \"Accept\": \"text/html,application/xhtml+xml,application/xml;q=0.9,*/*;"
"q=0.8\",\n"
"    \"Accept-Language\": \"en\",\n"
"}"
msgstr ""

#: ../../../topics/settings.rst:669
msgid ""
"The default headers used for Scrapy HTTP Requests. They're populated in the :"
"class:`~scrapy.downloadermiddlewares.defaultheaders."
"DefaultHeadersMiddleware`."
msgstr ""

#: ../../../topics/settings.rst:672
msgid ""
"Cookies set via the ``Cookie`` header are not considered by the :ref:`cookie "
"middleware <cookies>`. If you need to set cookies for a request, use the :"
"class:`Request.cookies <scrapy.Request>` parameter."
msgstr ""

#: ../../../topics/settings.rst:676
msgid ""
"A ``Referer`` header defined here only reaches requests for which :class:"
"`~scrapy.spidermiddlewares.referer.RefererMiddleware` does not set one, such "
"as start requests. To send it on every request, set :setting:"
"`REFERRER_POLICY` to ``\"no-referrer\"``."
msgstr ""

#: ../../../topics/settings.rst:684
msgid "DEPTH_LIMIT"
msgstr ""

#: ../../../topics/settings.rst:686 ../../../topics/settings.rst:698
#: ../../../topics/settings.rst:1826 ../../../topics/settings.rst:1859
msgid "Default: ``0``"
msgstr ""

#: ../../../topics/settings.rst:688 ../../../topics/settings.rst:700
#: ../../../topics/settings.rst:729
msgid "Scope: ``scrapy.spidermiddlewares.depth.DepthMiddleware``"
msgstr ""

#: ../../../topics/settings.rst:690
msgid ""
"The maximum depth that will be allowed to crawl for any site. If zero, no "
"limit will be imposed."
msgstr ""

#: ../../../topics/settings.rst:696
msgid "DEPTH_PRIORITY"
msgstr ""

#: ../../../topics/settings.rst:702
msgid ""
"An integer that is used to adjust the :attr:`~scrapy.Request.priority` of a :"
"class:`~scrapy.Request` based on its depth."
msgstr ""

#: ../../../topics/settings.rst:705
msgid "The priority of a request is adjusted as follows:"
msgstr ""

#: ../../../topics/settings.rst:708
msgid "request.priority = request.priority - (depth * DEPTH_PRIORITY)"
msgstr ""

#: ../../../topics/settings.rst:712
msgid ""
"As depth increases, positive values of ``DEPTH_PRIORITY`` decrease request "
"priority (BFO), while negative values increase request priority (DFO). See "
"also :ref:`faq-bfo-dfo`."
msgstr ""

#: ../../../topics/settings.rst:718
msgid ""
"This setting adjusts priority **in the opposite way** compared to other "
"priority settings :setting:`REDIRECT_PRIORITY_ADJUST` and :setting:"
"`RETRY_PRIORITY_ADJUST`."
msgstr ""

#: ../../../topics/settings.rst:725
msgid "DEPTH_STATS_VERBOSE"
msgstr ""

#: ../../../topics/settings.rst:727 ../../../topics/settings.rst:884
#: ../../../topics/settings.rst:1262 ../../../topics/settings.rst:1367
#: ../../../topics/settings.rst:1449 ../../../topics/settings.rst:1745
#: ../../../topics/settings.rst:1758 ../../../topics/settings.rst:1801
#: ../../../topics/settings.rst:1965 ../../../topics/settings.rst:2146
msgid "Default: ``False``"
msgstr ""

#: ../../../topics/settings.rst:731
msgid ""
"Whether to collect verbose depth stats. If this is enabled, the number of "
"requests for each depth is collected in the stats."
msgstr ""

#: ../../../topics/settings.rst:737
msgid "DNSCACHE_ENABLED"
msgstr ""

#: ../../../topics/settings.rst:739 ../../../topics/settings.rst:944
#: ../../../topics/settings.rst:1220 ../../../topics/settings.rst:1477
#: ../../../topics/settings.rst:1622 ../../../topics/settings.rst:1638
#: ../../../topics/settings.rst:1671 ../../../topics/settings.rst:1719
#: ../../../topics/settings.rst:1810 ../../../topics/settings.rst:2218
#: ../../../topics/settings.rst:2275 ../../../topics/settings.rst:2452
msgid "Default: ``True``"
msgstr ""

#: ../../../topics/settings.rst:741
msgid "Whether to enable DNS in-memory cache."
msgstr ""

#: ../../../topics/settings.rst:744
msgid ""
"This setting is only used by :class:`~scrapy.resolver."
"CachingThreadedResolver` and :class:`~scrapy.resolver."
"CachingHostnameResolver`. It has no effect when :setting:"
"`TWISTED_REACTOR_ENABLED` is ``False``, and may have no effect either when :"
"setting:`TWISTED_DNS_RESOLVER` is set to a different resolver."
msgstr ""

#: ../../../topics/settings.rst:755
msgid "DNSCACHE_SIZE"
msgstr ""

#: ../../../topics/settings.rst:757
msgid "Default: ``10000``"
msgstr ""

#: ../../../topics/settings.rst:759
msgid "DNS in-memory cache size, see :setting:`DNSCACHE_ENABLED`."
msgstr ""

#: ../../../topics/settings.rst:766
msgid "DNS_TIMEOUT"
msgstr ""

#: ../../../topics/settings.rst:768
msgid "Default: ``60``"
msgstr ""

#: ../../../topics/settings.rst:770
msgid "Timeout for processing of DNS queries in seconds. Float is supported."
msgstr ""

#: ../../../topics/settings.rst:772
msgid ""
"The timeout starts when the query is queued into the Twisted reactor thread "
"pool, not when it is sent. If that thread pool is saturated, queries can "
"time out before being sent, in which case increasing :setting:"
"`REACTOR_THREADPOOL_MAXSIZE` helps more than increasing this setting."
msgstr ""

#: ../../../topics/settings.rst:778
msgid ""
"This setting is only used by :class:`~scrapy.resolver."
"CachingThreadedResolver`. It has no effect when :setting:"
"`TWISTED_REACTOR_ENABLED` is ``False``, and may have no effect either when :"
"setting:`TWISTED_DNS_RESOLVER` is set to a different resolver."
msgstr ""

#: ../../../topics/settings.rst:788
msgid "DOWNLOADER"
msgstr ""

#: ../../../topics/settings.rst:790
msgid "Default: ``'scrapy.core.downloader.Downloader'``"
msgstr ""

#: ../../../topics/settings.rst:792
msgid "The downloader to use for crawling."
msgstr ""

#: ../../../topics/settings.rst:797
msgid "DOWNLOADER_CLIENT_TLS_CIPHERS"
msgstr ""

#: ../../../topics/settings.rst:799
msgid "Default: ``'DEFAULT'``"
msgstr ""

#: ../../../topics/settings.rst:801
msgid ""
"Use this setting to customize the TLS/SSL ciphers used by the HTTPS download "
"handler."
msgstr ""

#: ../../../topics/settings.rst:804
msgid ""
"The setting should contain a string in the `OpenSSL cipher list format`_, "
"these ciphers will be used as client ciphers. Changing this setting may be "
"necessary to access certain HTTPS websites: for example, you may need to use "
"``'DEFAULT:!DH'`` for a website with weak DH parameters or enable a specific "
"cipher that is not included in ``DEFAULT`` if a website requires it."
msgstr ""

#: ../../../topics/settings.rst:810
msgid ""
"Set this setting to ``None`` to use the default ciphers of the underlying "
"TLS implementation."
msgstr ""

#: ../../../topics/settings.rst:813
msgid "Added support for setting this to ``None``."
msgstr ""

#: ../../../topics/settings.rst:820 ../../../topics/settings.rst:893
#: ../../../topics/settings.rst:1159 ../../../topics/settings.rst:1244
#: ../../../topics/settings.rst:1484 ../../../topics/settings.rst:1509
#: ../../../topics/settings.rst:1526
msgid ""
"Handling of this setting needs to be implemented inside the :ref:`download "
"handler <topics-download-handlers>`, so it's not guaranteed to be supported "
"by all 3rd-party handlers."
msgstr ""

#: ../../../topics/settings.rst:824 ../../../topics/settings.rst:861
#: ../../../topics/settings.rst:877
msgid ":ref:`security-tls-protocols-ciphers`"
msgstr ""

#: ../../../topics/settings.rst:829
msgid "DOWNLOAD_TLS_MAX_VERSION"
msgstr ""

#: ../../../topics/settings.rst:835
msgid ""
"Use this setting to change the maximum version of the TLS protocol allowed "
"to be used by Scrapy."
msgstr ""

#: ../../../topics/settings.rst:838
msgid ""
"This setting must be either ``None``, in which case it doesn't affect the "
"version selection, or one of these string values:"
msgstr ""

#: ../../../topics/settings.rst:841
msgid "``'TLSv1.0'``"
msgstr ""

#: ../../../topics/settings.rst:842
msgid "``'TLSv1.1'``"
msgstr ""

#: ../../../topics/settings.rst:843
msgid "``'TLSv1.2'``"
msgstr ""

#: ../../../topics/settings.rst:844
msgid "``'TLSv1.3'``"
msgstr ""

#: ../../../topics/settings.rst:846
msgid ""
"The range of allowed TLS versions advertised by Scrapy when making TLS "
"connections will depend on the TLS implementation defaults and the values "
"of :setting:`DOWNLOAD_TLS_MIN_VERSION` and :setting:"
"`DOWNLOAD_TLS_MAX_VERSION`. It's possible to re-enable versions that are "
"supported by the TLS implementation but disabled by default by adjusting "
"these settings, but it's impossible to enable unsupported ones, such as any "
"versions below 1.2 in many modern environments."
msgstr ""

#: ../../../topics/settings.rst:856
msgid ""
"Handling of this setting needs to be implemented inside the :ref:`download "
"handler <topics-download-handlers>`, so it's not guaranteed to be supported "
"by all 3rd-party handlers. Additionally, the set of supported TLS versions "
"depends on the TLS implementation being used by the handler."
msgstr ""

#: ../../../topics/settings.rst:866
msgid "DOWNLOAD_TLS_MIN_VERSION"
msgstr ""

#: ../../../topics/settings.rst:872
msgid ""
"Use this setting to change the minimum version of the TLS protocol allowed "
"to be used by Scrapy."
msgstr ""

#: ../../../topics/settings.rst:875
msgid ""
"See :setting:`DOWNLOAD_TLS_MAX_VERSION` for the details and limitations."
msgstr ""

#: ../../../topics/settings.rst:882
msgid "DOWNLOADER_CLIENT_TLS_VERBOSE_LOGGING"
msgstr ""

#: ../../../topics/settings.rst:886
msgid ""
"Setting this to ``True`` will enable DEBUG level messages about TLS "
"connection parameters after establishing HTTPS connections. The kind of "
"information logged depends on the implementation of the download handler and "
"the versions of the TLS-related libraries."
msgstr ""

#: ../../../topics/settings.rst:900
msgid "DOWNLOADER_MIDDLEWARES"
msgstr ""

#: ../../../topics/settings.rst:904
msgid ""
"A dict containing the downloader middlewares enabled in your project, and "
"their orders. For more info see :ref:`topics-downloader-middleware-setting`."
msgstr ""

#: ../../../topics/settings.rst:910
msgid "DOWNLOADER_MIDDLEWARES_BASE"
msgstr ""

#: ../../../topics/settings.rst:914
msgid ""
"{\n"
"    \"scrapy.downloadermiddlewares.offsite.OffsiteMiddleware\": 50,\n"
"    \"scrapy.downloadermiddlewares.robotstxt.RobotsTxtMiddleware\": 100,\n"
"    \"scrapy.downloadermiddlewares.httpauth.HttpAuthMiddleware\": 300,\n"
"    \"scrapy.downloadermiddlewares.downloadtimeout."
"DownloadTimeoutMiddleware\": 350,\n"
"    \"scrapy.downloadermiddlewares.defaultheaders."
"DefaultHeadersMiddleware\": 400,\n"
"    \"scrapy.downloadermiddlewares.useragent.UserAgentMiddleware\": 500,\n"
"    \"scrapy.downloadermiddlewares.retry.RetryMiddleware\": 550,\n"
"    \"scrapy.downloadermiddlewares.redirect.MetaRefreshMiddleware\": 580,\n"
"    \"scrapy.downloadermiddlewares.httpcompression."
"HttpCompressionMiddleware\": 590,\n"
"    \"scrapy.downloadermiddlewares.redirect.RedirectMiddleware\": 600,\n"
"    \"scrapy.downloadermiddlewares.cookies.CookiesMiddleware\": 700,\n"
"    \"scrapy.downloadermiddlewares.httpproxy.HttpProxyMiddleware\": 750,\n"
"    \"scrapy.downloadermiddlewares.stats.DownloaderStats\": 850,\n"
"    \"scrapy.downloadermiddlewares.httpcache.HttpCacheMiddleware\": 900,\n"
"}"
msgstr ""

#: ../../../topics/settings.rst:933
msgid ""
"A dict containing the downloader middlewares enabled by default in Scrapy. "
"Low orders are closer to the engine, high orders are closer to the "
"downloader. You should never modify this setting in your project, modify :"
"setting:`DOWNLOADER_MIDDLEWARES` instead.  For more info see :ref:`topics-"
"downloader-middleware-setting`."
msgstr ""

#: ../../../topics/settings.rst:942
msgid "DOWNLOADER_STATS"
msgstr ""

#: ../../../topics/settings.rst:946
msgid "Whether to enable downloader stats collection."
msgstr ""

#: ../../../topics/settings.rst:951
msgid "DOWNLOAD_DELAY"
msgstr ""

#: ../../../topics/settings.rst:953
msgid "Default: ``1`` (:ref:`fallback <default-settings>`: ``0``)"
msgstr ""

#: ../../../topics/settings.rst:955
msgid ""
"Minimum seconds to wait between 2 consecutive requests to the same domain."
msgstr ""

#: ../../../topics/settings.rst:957
msgid ""
"Use :setting:`DOWNLOAD_DELAY` to throttle your crawling speed, to avoid "
"hitting servers too hard."
msgstr ""

#: ../../../topics/settings.rst:960
msgid ""
"Decimal numbers are supported. For example, to send a maximum of 4 requests "
"every 10 seconds:"
msgstr ""

#: ../../../topics/settings.rst:963
msgid "DOWNLOAD_DELAY = 2.5"
msgstr ""

#: ../../../topics/settings.rst:967
msgid ""
"This setting is also affected by the :setting:`DOWNLOAD_DELAY_JITTER` "
"setting, which randomizes delays by ±50% by default."
msgstr ""

#: ../../../topics/settings.rst:970
msgid ""
"Note that :setting:`DOWNLOAD_DELAY` can lower the effective per-domain "
"concurrency below :setting:`CONCURRENT_REQUESTS_PER_DOMAIN`. If the response "
"time of a domain is lower than :setting:`DOWNLOAD_DELAY`, the effective "
"concurrency for that domain is 1. When testing throttling configurations, it "
"usually makes sense to lower :setting:`CONCURRENT_REQUESTS_PER_DOMAIN` "
"first, and only increase :setting:`DOWNLOAD_DELAY` once :setting:"
"`CONCURRENT_REQUESTS_PER_DOMAIN` is 1 but a higher throttling is desired."
msgstr ""

#: ../../../topics/settings.rst:987
msgid "DOWNLOAD_DELAY_JITTER"
msgstr ""

#: ../../../topics/settings.rst:991
msgid "Default: ``0.5``"
msgstr ""

#: ../../../topics/settings.rst:993
msgid ""
"Magnitude of the random variation applied to :setting:`DOWNLOAD_DELAY`, e.g. "
"``0.2`` spreads delays between 80% and 120% of :setting:`DOWNLOAD_DELAY`. "
"``0`` disables randomization."
msgstr ""

#: ../../../topics/settings.rst:997
msgid ""
"Randomizing delays makes the time between requests less uniform, resulting "
"in a more natural crawling pattern."
msgstr ""

#: ../../../topics/settings.rst:1006
msgid "DOWNLOAD_BIND_ADDRESS"
msgstr ""

#: ../../../topics/settings.rst:1010
msgid "The default local outgoing address for download-handler connections."
msgstr ""

#: ../../../topics/settings.rst:1012
msgid "This setting can be either:"
msgstr ""

#: ../../../topics/settings.rst:1014
msgid ""
"a host address as a string (e.g. ``\"127.0.0.2\"``), in which case the local "
"port is chosen automatically, or"
msgstr ""

#: ../../../topics/settings.rst:1017
msgid ""
"a ``(host, port)`` tuple (e.g. ``(\"127.0.0.2\", 50000)``) to bind to both a "
"specific local interface and a specific local port."
msgstr ""

#: ../../../topics/settings.rst:1022
msgid ""
"# Bind to this local address\n"
"DOWNLOAD_BIND_ADDRESS = \"127.0.0.2\""
msgstr ""

#: ../../../topics/settings.rst:1027
msgid ""
"# Bind to this local address and local port\n"
"DOWNLOAD_BIND_ADDRESS = (\"127.0.0.2\", 5000)"
msgstr ""

#: ../../../topics/settings.rst:1032
msgid ""
"If set, built-in HTTP download handlers use this value by default. Set the :"
"reqmeta:`bindaddress` request meta key to override it for a specific request."
msgstr ""

#: ../../../topics/settings.rst:1038
msgid ""
"Handling of this setting needs to be implemented inside the :ref:`download "
"handler <topics-download-handlers>`, so it's not guaranteed to be supported "
"by all 3rd-party handlers. Specifying the port is unsupported by :class:"
"`~scrapy.core.downloader.handlers._httpx.HttpxDownloadHandler`."
msgstr ""

#: ../../../topics/settings.rst:1046
msgid "DOWNLOAD_HANDLERS"
msgstr ""

#: ../../../topics/settings.rst:1050
msgid ""
"A dict containing the :ref:`download handlers <topics-download-handlers>` "
"enabled in your project."
msgstr ""

#: ../../../topics/settings.rst:1053
msgid "See :setting:`DOWNLOAD_HANDLERS_BASE` for example format."
msgstr ""

#: ../../../topics/settings.rst:1055 ../../../topics/settings.rst:1105
msgid ""
":ref:`security-unencrypted-protocols` and :ref:`security-local-resources`"
msgstr ""

#: ../../../topics/settings.rst:1061
msgid "DOWNLOAD_HANDLERS_BASE"
msgstr ""

#: ../../../topics/settings.rst:1065
msgid ""
"{\n"
"    \"data\": \"scrapy.core.downloader.handlers.datauri."
"DataURIDownloadHandler\",\n"
"    \"file\": \"scrapy.core.downloader.handlers.file.FileDownloadHandler\",\n"
"    \"http\": \"scrapy.core.downloader.handlers.http11."
"HTTP11DownloadHandler\",\n"
"    \"https\": \"scrapy.core.downloader.handlers.http11."
"HTTP11DownloadHandler\",\n"
"    \"s3\": \"scrapy.core.downloader.handlers.s3.S3DownloadHandler\",\n"
"    \"ftp\": \"scrapy.core.downloader.handlers.ftp.FTPDownloadHandler\",\n"
"}"
msgstr ""

#: ../../../topics/settings.rst:1076
msgid "(when :setting:`TWISTED_REACTOR_ENABLED` is ``True``)"
msgstr ""

#: ../../../topics/settings.rst:1078
msgid ""
"{\n"
"    \"data\": \"scrapy.core.downloader.handlers.datauri."
"DataURIDownloadHandler\",\n"
"    \"file\": \"scrapy.core.downloader.handlers.file.FileDownloadHandler\",\n"
"    \"http\": \"scrapy.core.downloader.handlers._httpx."
"HttpxDownloadHandler\",\n"
"    \"https\": \"scrapy.core.downloader.handlers._httpx."
"HttpxDownloadHandler\",\n"
"    \"s3\": \"scrapy.core.downloader.handlers.s3.S3DownloadHandler\",\n"
"    \"ftp\": None,\n"
"}"
msgstr ""

#: ../../../topics/settings.rst:1089
msgid "(when :setting:`TWISTED_REACTOR_ENABLED` is ``False``)"
msgstr ""

#: ../../../topics/settings.rst:1091
msgid ""
"A dict containing the :ref:`download handlers <topics-download-handlers>` "
"enabled by default in Scrapy. You should never modify this setting in your "
"project, modify :setting:`DOWNLOAD_HANDLERS` instead."
msgstr ""

#: ../../../topics/settings.rst:1095
msgid ""
"You can disable any of these download handlers by assigning ``None`` to "
"their URI scheme in :setting:`DOWNLOAD_HANDLERS`. E.g., to disable the built-"
"in FTP handler (without replacement), place this in your ``settings.py``:"
msgstr ""

#: ../../../topics/settings.rst:1099
msgid ""
"DOWNLOAD_HANDLERS = {\n"
"    \"ftp\": None,\n"
"}"
msgstr ""

#: ../../../topics/settings.rst:1113
msgid "DOWNLOAD_SLOTS"
msgstr ""

#: ../../../topics/settings.rst:1117
msgid ""
"Allows to define concurrency/delay parameters on per slot (domain) basis:"
msgstr ""

#: ../../../topics/settings.rst:1119
msgid ""
"DOWNLOAD_SLOTS = {\n"
"    \"quotes.toscrape.com\": {\"concurrency\": 1, \"delay\": 2, \"jitter\": "
"0},\n"
"    \"books.toscrape.com\": {\"delay\": 3, \"jitter\": 0.2},\n"
"}"
msgstr ""

#: ../../../topics/settings.rst:1128
msgid "For other downloader slots default settings values will be used:"
msgstr ""

#: ../../../topics/settings.rst:1130
msgid ":setting:`DOWNLOAD_DELAY`: ``delay``"
msgstr ""

#: ../../../topics/settings.rst:1131
msgid ":setting:`CONCURRENT_REQUESTS_PER_DOMAIN`: ``concurrency``"
msgstr ""

#: ../../../topics/settings.rst:1132
msgid ":setting:`DOWNLOAD_DELAY_JITTER`: ``jitter``"
msgstr ""

#: ../../../topics/settings.rst:1134
msgid ""
"Requests are assigned to a slot based on their URL domain. To assign a "
"request to a specific slot instead, set the name of the slot as the "
"``download_slot`` :attr:`Request.meta <scrapy.Request.meta>` key. Once a "
"request is assigned to a slot, that key holds the name of the slot."
msgstr ""

#: ../../../topics/settings.rst:1139
msgid ""
"Since that key is kept on redirects, a redirected request stays in the slot "
"of the request it comes from, even when it points to a different domain."
msgstr ""

#: ../../../topics/settings.rst:1146
msgid "DOWNLOAD_TIMEOUT"
msgstr ""

#: ../../../topics/settings.rst:1148
msgid "Default: ``180``"
msgstr ""

#: ../../../topics/settings.rst:1150
msgid ""
"The amount of time (in secs) that the downloader will wait before timing out."
msgstr ""

#: ../../../topics/settings.rst:1154
msgid ""
"This timeout can be per-request using the :reqmeta:`download_timeout` :attr:"
"`.Request.meta` key."
msgstr ""

#: ../../../topics/settings.rst:1167
msgid "DOWNLOAD_MAXSIZE"
msgstr ""

#: ../../../topics/settings.rst:1169
msgid "Default: ``1073741824`` (1 GiB)"
msgstr ""

#: ../../../topics/settings.rst:1171
msgid ""
"The maximum response body size (in bytes) allowed. Bigger responses are "
"aborted and ignored."
msgstr ""

#: ../../../topics/settings.rst:1174
msgid ""
"This applies both before and after compression. If decompressing a response "
"body would exceed this limit, decompression is aborted and the response is "
"ignored."
msgstr ""

#: ../../../topics/settings.rst:1178 ../../../topics/settings.rst:1202
msgid "Use ``0`` to disable this limit."
msgstr ""

#: ../../../topics/settings.rst:1182
msgid ""
"This limit can be set per-request using the :reqmeta:`download_maxsize` :"
"attr:`.Request.meta` key."
msgstr ""

#: ../../../topics/settings.rst:1187 ../../../topics/settings.rst:1211
msgid ""
"Checking responses before decompressing them needs to be implemented inside "
"the :ref:`download handler <topics-download-handlers>`, so it's not "
"guaranteed to be supported by all 3rd-party handlers."
msgstr ""

#: ../../../topics/settings.rst:1195
msgid "DOWNLOAD_WARNSIZE"
msgstr ""

#: ../../../topics/settings.rst:1197
msgid "Default: ``33554432`` (32 MiB)"
msgstr ""

#: ../../../topics/settings.rst:1199
msgid ""
"If the size of a response exceeds this value, before or after compression, a "
"warning will be logged about it."
msgstr ""

#: ../../../topics/settings.rst:1206
msgid ""
"This limit can be set per-request using the :reqmeta:`download_warnsize` :"
"attr:`.Request.meta` key."
msgstr ""

#: ../../../topics/settings.rst:1218
msgid "DOWNLOAD_FAIL_ON_DATALOSS"
msgstr ""

#: ../../../topics/settings.rst:1222
msgid ""
"Whether or not to fail on broken responses, that is, when the declared "
"``Content-Length`` does not match content sent by the server or a chunked "
"response was not properly finished. If ``True``, these responses raise a :"
"exc:`~scrapy.exceptions.ResponseDataLossError` exception. If ``False``, "
"these responses are passed through and the flag ``dataloss`` is added to the "
"response, i.e.: ``'dataloss' in response.flags`` is ``True``."
msgstr ""

#: ../../../topics/settings.rst:1229
msgid ""
"Optionally, this can be set per-request basis by using the :reqmeta:"
"`download_fail_on_dataloss` Request.meta key to ``False``."
msgstr ""

#: ../../../topics/settings.rst:1234
msgid ""
"A broken response, or data loss error, may happen under several "
"circumstances, from server misconfiguration to network errors to data "
"corruption. It is up to the user to decide if it makes sense to process "
"broken responses considering they may contain partial or incomplete content. "
"If :setting:`RETRY_ENABLED` is ``True`` and this setting is set to ``True``, "
"the :exc:`~scrapy.exceptions.ResponseDataLossError` failure will be retried "
"as usual."
msgstr ""

#: ../../../topics/settings.rst:1250
msgid ""
"This setting is ignored by the :class:`~scrapy.core.downloader.handlers."
"http2.H2DownloadHandler` :ref:`download handler <topics-download-handlers>`. "
"In case of a data loss error, the corresponding HTTP/2 connection may be "
"corrupted, affecting other requests that use the same connection; hence, a "
"``ResponseFailed([InvalidBodyLengthError])`` failure is always raised for "
"every request that was using that connection."
msgstr ""

#: ../../../topics/settings.rst:1260
msgid "DOWNLOAD_VERIFY_CERTIFICATES"
msgstr ""

#: ../../../topics/settings.rst:1264
msgid ""
"Whether the HTTPS download handlers should verify the server TLS certificate "
"when making a request and abort the request if the verification fails."
msgstr ""

#: ../../../topics/settings.rst:1269
msgid ""
"Handling of this setting needs to be implemented inside the :ref:`download "
"handler <topics-download-handlers>`, so it's not guaranteed to be supported "
"by all 3rd-party handlers. The exact behavior of a handler (e.g. whether "
"certificate problems are logged when this setting is set to ``False``) "
"depends on its implementation."
msgstr ""

#: ../../../topics/settings.rst:1275
msgid ":ref:`security-certificate-verification`"
msgstr ""

#: ../../../topics/settings.rst:1280
msgid "DUPEFILTER_CLASS"
msgstr ""

#: ../../../topics/settings.rst:1282
msgid "Default: ``'scrapy.dupefilters.RFPDupeFilter'``"
msgstr ""

#: ../../../topics/settings.rst:1284
msgid "The class used to detect and filter duplicate requests."
msgstr ""

#: ../../../topics/settings.rst:1286
msgid ""
"The default, :class:`~scrapy.dupefilters.RFPDupeFilter`, filters based on "
"the :setting:`REQUEST_FINGERPRINTER_CLASS` setting."
msgstr ""

#: ../../../topics/settings.rst:1289
msgid ""
"To change how duplicates are checked, you can point :setting:"
"`DUPEFILTER_CLASS` to a custom subclass of :class:`~scrapy.dupefilters."
"RFPDupeFilter` that overrides its ``__init__`` method to use a :ref:"
"`different request fingerprinting class <custom-request-fingerprinter>`. For "
"example:"
msgstr ""

#: ../../../topics/settings.rst:1294
msgid ""
"from scrapy.dupefilters import RFPDupeFilter\n"
"from scrapy.utils.request import fingerprint\n"
"\n"
"\n"
"class CustomRequestFingerprinter:\n"
"    def fingerprint(self, request):\n"
"        return fingerprint(request, include_headers=[\"X-ID\"])\n"
"\n"
"\n"
"class CustomDupeFilter(RFPDupeFilter):\n"
"\n"
"    def __init__(self, path=None, debug=False, *, fingerprinter=None):\n"
"        super().__init__(\n"
"            path=path, debug=debug, "
"fingerprinter=CustomRequestFingerprinter()\n"
"        )"
msgstr ""

#: ../../../topics/settings.rst:1312
msgid ""
"To disable duplicate request filtering set :setting:`DUPEFILTER_CLASS` to "
"``'scrapy.dupefilters.BaseDupeFilter'``. Note that not filtering out "
"duplicate requests may cause crawling loops. It is usually better to set the "
"``dont_filter`` parameter to ``True`` on the ``__init__`` method of a "
"specific :class:`~scrapy.Request` object that should not be filtered out."
msgstr ""

#: ../../../topics/settings.rst:1318
msgid ""
"A class assigned to :setting:`DUPEFILTER_CLASS` must implement the following "
"interface:"
msgstr ""

#: ../../../topics/settings.rst:1321
msgid ""
"class MyDupeFilter:\n"
"\n"
"    @classmethod\n"
"    def from_crawler(cls, crawler):\n"
"        \"\"\"Returns an instance of this duplicate request filtering class\n"
"        based on the current Crawler instance.\"\"\"\n"
"        return cls()\n"
"\n"
"    def request_seen(self, request):\n"
"        \"\"\"Returns ``True`` if *request* is a duplicate of another "
"request\n"
"        seen in a previous call to :meth:`request_seen`, or ``False``\n"
"        otherwise.\"\"\"\n"
"        return False\n"
"\n"
"    def open(self):\n"
"        \"\"\"Called before the spider opens. It may return a deferred."
"\"\"\"\n"
"        pass\n"
"\n"
"    def close(self, reason):\n"
"        \"\"\"Called before the spider closes. It may return a deferred."
"\"\"\"\n"
"        pass\n"
"\n"
"    def log(self, request, spider):\n"
"        \"\"\"Logs that a request has been filtered out.\n"
"\n"
"        It is called right after a call to :meth:`request_seen` that\n"
"        returns ``True``.\n"
"\n"
"        If :meth:`request_seen` always returns ``False``, such as in the\n"
"        case of :class:`~scrapy.dupefilters.BaseDupeFilter`, this method\n"
"        may be omitted.\n"
"        \"\"\"\n"
"        pass"
msgstr ""

#: ../../../topics/settings.rst:1365
msgid "DUPEFILTER_DEBUG"
msgstr ""

#: ../../../topics/settings.rst:1369
msgid ""
"By default, ``RFPDupeFilter`` only logs the first duplicate request. "
"Setting :setting:`DUPEFILTER_DEBUG` to ``True`` will make it log all "
"duplicate requests."
msgstr ""

#: ../../../topics/settings.rst:1375
msgid "EDITOR"
msgstr ""

#: ../../../topics/settings.rst:1377
msgid "Default: ``vi`` (on Unix systems) or the IDLE editor (on Windows)"
msgstr ""

#: ../../../topics/settings.rst:1379
msgid ""
"The editor to use for editing spiders with the :command:`edit` command. "
"Additionally, if the ``EDITOR`` environment variable is set, the :command:"
"`edit` command will prefer it over the default setting."
msgstr ""

#: ../../../topics/settings.rst:1386
msgid "EXTENSIONS"
msgstr ""

#: ../../../topics/settings.rst:1390
msgid ""
":ref:`Component priority dictionary <component-priority-dictionaries>` of "
"enabled extensions. See :ref:`topics-extensions`."
msgstr ""


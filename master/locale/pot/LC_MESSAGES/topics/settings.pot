msgid "See :ref:`topics-extensions-ref-memusage`."
msgstr ""

#: ../../../topics/settings.rst:1824
msgid "MEMUSAGE_LIMIT_MB"
msgstr ""

#: ../../../topics/settings.rst:1830
msgid ""
"The maximum amount of memory to allow (in megabytes) before shutting down "
"Scrapy (if :setting:`MEMUSAGE_ENABLED` is ``True``). If zero, no check will "
"be performed."
msgstr ""

#: ../../../topics/settings.rst:1839
msgid "MEMUSAGE_CHECK_INTERVAL_SECONDS"
msgstr ""

#: ../../../topics/settings.rst:1845

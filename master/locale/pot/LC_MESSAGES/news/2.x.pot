msgstr ""

#: ../../../news/2.x.rst:1082
msgid ""
"Added :class:`~scrapy.contracts.default.MetadataContract` that sets the "
"request meta. (:gh:`6468`, :gh:`6469`)"
msgstr ""

#: ../../../news/2.x.rst:1089

#: ../../../topics/downloader-middleware.rst:263
msgid "HttpAuthMiddleware"
msgstr ""

#: ../../../topics/downloader-middleware.rst:270
msgid ""
"This middleware authenticates requests using `Basic access authentication`_ "
"(aka. HTTP auth)."
msgstr ""

#: ../../../topics/downloader-middleware.rst:273
msgid ""
"Use the :setting:`HTTPAUTH_USER`, :setting:`HTTPAUTH_PASS`, and :setting:"
"`HTTPAUTH_DOMAIN` settings to configure it. You can also override the "
"credentials per request via :attr:`~scrapy.Request.meta` keys :reqmeta:"
"`http_user`, :reqmeta:`http_pass`, and :reqmeta:`http_auth_domain`."
msgstr ""

#: ../../../topics/downloader-middleware.rst:278
msgid ""
"Example using settings (e.g. in :attr:`~scrapy.Spider.custom_settings`):"
msgstr ""

#: ../../../topics/downloader-middleware.rst:280
msgid ""
"from scrapy.spiders import CrawlSpider\n"
"\n"
"\n"
"class SomeIntranetSiteSpider(CrawlSpider):\n"
"    name = \"intranet.example.com\"\n"
"    custom_settings = {\n"
"        \"HTTPAUTH_USER\": \"someuser\",\n"
"        \"HTTPAUTH_PASS\": \"somepass\",\n"
"        \"HTTPAUTH_DOMAIN\": \"intranet.example.com\",\n"
"    }\n"
"\n"
"    # .. rest of the spider code omitted ..."
msgstr ""

#: ../../../topics/downloader-middleware.rst:295
msgid "Example using per-request meta:"
msgstr ""

#: ../../../topics/downloader-middleware.rst:297
msgid ""
"async def start(self):\n"
"    yield Request(\n"
"        \"https://intranet.example.com/protected/\",\n"
"        meta={\n"
"            \"http_user\": \"someuser\",\n"
"            \"http_pass\": \"somepass\",\n"
"            \"http_auth_domain\": \"intranet.example.com\",\n"
"        },\n"
"    )"
msgstr ""


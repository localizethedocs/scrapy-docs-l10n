#: ../../../topics/extensions.rst:383
msgid "This extension logs the following configurable sections:"
msgstr ""

#: ../../../topics/extensions.rst:385
msgid ""
"``\"delta\"`` shows how some numeric stats have changed since the last stats "
"log message."
msgstr ""

#: ../../../topics/extensions.rst:388
msgid ""
"The :setting:`PERIODIC_LOG_DELTA` setting determines the target stats. They "
"must have ``int`` or ``float`` values."
msgstr ""

#: ../../../topics/extensions.rst:391
msgid "``\"stats\"`` shows the current value of some stats."
msgstr ""

#: ../../../topics/extensions.rst:393
msgid "The :setting:`PERIODIC_LOG_STATS` setting determines the target stats."
msgstr ""

#: ../../../topics/extensions.rst:395
msgid "``\"time\"`` shows detailed timing data."
msgstr ""

#: ../../../topics/extensions.rst:397
msgid ""
"The :setting:`PERIODIC_LOG_TIMING_ENABLED` setting determines whether or not "
"to show this section."
msgstr ""

#: ../../../topics/extensions.rst:400
msgid ""
"This extension logs data at the start, then on a fixed time interval "
"configurable through the :setting:`LOGSTATS_INTERVAL` setting, and finally "
"right before the crawl ends."
msgstr ""

#: ../../../topics/extensions.rst:405
msgid "Example extension configuration:"
msgstr ""

#: ../../../topics/extensions.rst:407
msgid ""
"custom_settings = {\n"
"    \"LOG_LEVEL\": \"INFO\",\n"
"    \"PERIODIC_LOG_STATS\": {\n"
"        \"include\": [\"downloader/\", \"scheduler/\", \"log_count/\", "
"\"item_scraped_count\"],\n"
"    },\n"
"    \"PERIODIC_LOG_DELTA\": {\"include\": [\"downloader/\"]},\n"
"    \"PERIODIC_LOG_TIMING_ENABLED\": True,\n"
"    \"EXTENSIONS\": {\n"
"        \"scrapy.extensions.periodic_log.PeriodicLog\": 0,\n"
"    },\n"
"}"
msgstr ""

#: ../../../topics/extensions.rst:424
msgid "PERIODIC_LOG_DELTA"
msgstr ""

#: ../../../topics/extensions.rst:426 ../../../topics/extensions.rst:437
msgid "Default: ``None``"
msgstr ""

#: ../../../topics/extensions.rst:428
msgid ""
"``\"PERIODIC_LOG_DELTA\": True`` - show deltas for all ``int`` and ``float`` "
"stat values."
msgstr ""

#: ../../../topics/extensions.rst:429
msgid ""
"``\"PERIODIC_LOG_DELTA\": {\"include\": [\"downloader/\", \"scheduler/\"]}`` "
"- show deltas for stats with names containing any configured substring."
msgstr ""

#: ../../../topics/extensions.rst:430
msgid ""
"``\"PERIODIC_LOG_DELTA\": {\"exclude\": [\"downloader/\"]}`` - show deltas "
"for all stats with names not containing any configured substring."
msgstr ""

#: ../../../topics/extensions.rst:435
msgid "PERIODIC_LOG_STATS"
msgstr ""

#: ../../../topics/extensions.rst:439
msgid "``\"PERIODIC_LOG_STATS\": True`` - show the current value of all stats."
msgstr ""

#: ../../../topics/extensions.rst:440
msgid ""
"``\"PERIODIC_LOG_STATS\": {\"include\": [\"downloader/\", \"scheduler/\"]}`` "
"- show current values for stats with names containing any configured "
"substring."
msgstr ""

#: ../../../topics/extensions.rst:441
msgid ""
"``\"PERIODIC_LOG_STATS\": {\"exclude\": [\"downloader/\"]}`` - show current "
"values for all stats with names not containing any configured substring."
msgstr ""

#: ../../../topics/extensions.rst:447
msgid "PERIODIC_LOG_TIMING_ENABLED"
msgstr ""

#: ../../../topics/extensions.rst:449
msgid "Default: ``False``"
msgstr ""

#: ../../../topics/extensions.rst:451
msgid ""
"``True`` enables logging of timing data (i.e. the ``\"time\"`` section)."
msgstr ""


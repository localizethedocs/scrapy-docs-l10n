#: ../../../topics/spiders.rst:5
msgid "Spiders"
msgstr ""

#: ../../../topics/spiders.rst:7
msgid ""
"Spiders are classes that define how a site, or a group of sites, is scraped: "
"which requests to send, and how to parse their responses to extract data and "
"to send additional requests."
msgstr ""

#: ../../../topics/spiders.rst:11
msgid "A crawl goes as follows:"
msgstr ""

#: ../../../topics/spiders.rst:13
msgid ""
"Scrapy iterates the :meth:`~scrapy.Spider.start` method of the spider to get "
"the initial requests. By default, that method yields a :class:`~scrapy."
"Request` object for each URL in :attr:`~scrapy.Spider.start_urls`, with :"
"meth:`~scrapy.Spider.parse` as :ref:`callback <callbacks>`."
msgstr ""

#: ../../../topics/spiders.rst:19
msgid ""
"Scrapy downloads each request and calls its callback with the resulting :"
"class:`~scrapy.http.Response`."
msgstr ""

#: ../../../topics/spiders.rst:22
msgid ""
"Callbacks parse the response, typically using :ref:`topics-selectors`, and "
"return or yield :ref:`item objects <topics-items>` with the extracted data "
"and :class:`~scrapy.Request` objects to continue the crawl, which go back to "
"step 2. See :ref:`callback-output`."
msgstr ""

#: ../../../topics/spiders.rst:27
msgid ""
"Items go through :ref:`item pipelines <topics-item-pipeline>`, and are "
"usually stored through :ref:`topics-feed-exports`."
msgstr ""

#: ../../../topics/spiders.rst:30
msgid ""
"Scrapy includes different spider classes for different purposes, described "
"below."
msgstr ""

#: ../../../topics/spiders.rst:36
msgid "scrapy.Spider"
msgstr ""

#: ../../../topics/spiders.rst:196
msgid "Let's see an example:"
msgstr ""

#: ../../../topics/spiders.rst:198
msgid ""
"import scrapy\n"
"\n"
"\n"
"class MySpider(scrapy.Spider):\n"
"    name = \"example.com\"\n"
"    allowed_domains = [\"example.com\"]\n"
"    start_urls = [\n"
"        \"http://www.example.com/1.html\",\n"
"        \"http://www.example.com/2.html\",\n"
"        \"http://www.example.com/3.html\",\n"
"    ]\n"
"\n"
"    def parse(self, response):\n"
"        self.logger.info(\"A response from %s just arrived!\", response.url)"
msgstr ""

#: ../../../topics/spiders.rst:215
msgid "Return multiple Requests and items from a single callback:"
msgstr ""

#: ../../../topics/spiders.rst:217
msgid ""
"import scrapy\n"
"\n"
"\n"
"class MySpider(scrapy.Spider):\n"
"    name = \"example.com\"\n"
"    allowed_domains = [\"example.com\"]\n"
"    start_urls = [\n"
"        \"http://www.example.com/1.html\",\n"
"        \"http://www.example.com/2.html\",\n"
"        \"http://www.example.com/3.html\",\n"
"    ]\n"
"\n"
"    def parse(self, response):\n"
"        for h3 in response.xpath(\"//h3\").getall():\n"
"            yield {\"title\": h3}\n"
"\n"
"        for href in response.xpath(\"//a/@href\").getall():\n"
"            yield scrapy.Request(response.urljoin(href), self.parse)"
msgstr ""

#: ../../../topics/spiders.rst:238
msgid ""
"Instead of :attr:`~.start_urls` you can use :meth:`~scrapy.Spider.start` "
"directly; to give data more structure you can use :class:`~scrapy.Item` "
"objects:"
msgstr ""

#: ../../../topics/spiders.rst:243
msgid ""
"import scrapy\n"
"from myproject.items import MyItem\n"
"\n"
"\n"
"class MySpider(scrapy.Spider):\n"
"    name = \"example.com\"\n"
"    allowed_domains = [\"example.com\"]\n"
"\n"
"    async def start(self):\n"
"        yield scrapy.Request(\"http://www.example.com/1.html\", self.parse)\n"
"        yield scrapy.Request(\"http://www.example.com/2.html\", self.parse)\n"
"        yield scrapy.Request(\"http://www.example.com/3.html\", self.parse)\n"
"\n"
"    def parse(self, response):\n"
"        for h3 in response.xpath(\"//h3\").getall():\n"
"            yield MyItem(title=h3)\n"
"\n"
"        for href in response.xpath(\"//a/@href\").getall():\n"
"            yield scrapy.Request(response.urljoin(href), self.parse)"
msgstr ""

#: ../../../topics/spiders.rst:268
msgid "Spider arguments"
msgstr ""

#: ../../../topics/spiders.rst:270
msgid ""
"Spiders can receive arguments that modify their behaviour. Some common uses "
"for spider arguments are to define the start URLs or to restrict the crawl "
"to certain sections of the site, but they can be used to configure any "
"functionality of the spider."
msgstr ""

#: ../../../topics/spiders.rst:275
msgid ""
"Spider arguments are passed through the :command:`crawl` command using the "
"``-a`` option. For example::"
msgstr ""

#: ../../../topics/spiders.rst:278
msgid "scrapy crawl myspider -a category=electronics"
msgstr ""

#: ../../../topics/spiders.rst:280
msgid "Spiders can access arguments in their `__init__` methods:"
msgstr ""

#: ../../../topics/spiders.rst:282
msgid ""
"import scrapy\n"
"\n"
"\n"
"class MySpider(scrapy.Spider):\n"
"    name = \"myspider\"\n"
"\n"
"    def __init__(self, category=None, *args, **kwargs):\n"
"        super().__init__(*args, **kwargs)\n"
"        self.start_urls = [f\"http://www.example.com/categories/"
"{category}\"]\n"
"        # ..."
msgstr ""

#: ../../../topics/spiders.rst:295
msgid ""
"The default `__init__` method will take any spider arguments and copy them "
"to the spider as attributes. The above example can also be written as "
"follows:"
msgstr ""

#: ../../../topics/spiders.rst:299
msgid ""
"import scrapy\n"
"\n"
"\n"
"class MySpider(scrapy.Spider):\n"
"    name = \"myspider\"\n"
"\n"
"    async def start(self):\n"
"        yield scrapy.Request(f\"http://www.example.com/categories/{self."
"category}\")"
msgstr ""

#: ../../../topics/spiders.rst:310
msgid ""
"If you are :ref:`running Scrapy from a script <run-from-script>`, you can "
"specify spider arguments when calling :meth:`CrawlerProcess.crawl <scrapy."
"crawler.CrawlerProcess.crawl>` or :meth:`CrawlerRunner.crawl <scrapy.crawler."
"CrawlerRunner.crawl>`:"
msgstr ""

#: ../../../topics/spiders.rst:316
msgid ""
"process = CrawlerProcess()\n"
"process.crawl(MySpider, category=\"electronics\")"
msgstr ""

#: ../../../topics/spiders.rst:321
msgid ""
"Keep in mind that spider arguments are only strings. The spider will not do "
"any parsing on its own. If you were to set the ``start_urls`` attribute from "
"the command line, you would have to parse it on your own into a list using "
"something like :func:`ast.literal_eval` or :func:`json.loads` and then set "
"it as an attribute. Otherwise, you would cause iteration over a "
"``start_urls`` string (a very common python pitfall) resulting in each "
"character being seen as a separate url."
msgstr ""

#: ../../../topics/spiders.rst:331
msgid ""
"Spider arguments can also be passed through the Scrapyd ``schedule.json`` "
"API. See `Scrapyd documentation`_."
msgstr ""

#: ../../../topics/spiders.rst:337
msgid "scrapy-spider-metadata parameters"
msgstr ""

#: ../../../topics/spiders.rst:339
msgid ""
"Another alternative to pass spider arguments is the library `scrapy-spider-"
"metadata`_."
msgstr ""

#: ../../../topics/spiders.rst:341
msgid ""
"This allows for Scrapy spiders to define, validate, document and pre-process "
"their arguments as Pydantic models."
msgstr ""

#: ../../../topics/spiders.rst:344
msgid ""
"The example shows how to define typed parameters where a string argument is "
"automatically converted to an integer:"
msgstr ""

#: ../../../topics/spiders.rst:347
msgid ""
"import scrapy\n"
"from pydantic import BaseModel\n"
"from scrapy_spider_metadata import Args\n"
"\n"
"\n"
"class MyParams(BaseModel):\n"
"    pages: int\n"
"\n"
"\n"
"class BookSpider(Args[MyParams], scrapy.Spider):\n"
"    name = \"bookspider\"\n"
"    start_urls = [\"http://books.toscrape.com/catalogue\"]\n"
"\n"
"    async def start(self):\n"
"        for start_url in self.start_urls:\n"
"            for index in range(1, self.args.pages + 1):\n"
"                yield scrapy.Request(f\"{start_url}/page-{index}.html\")\n"
"\n"
"    def parse(self, response):\n"
"        book_links = response.css(\"article.product_pod h3 a::attr(href)\")."
"getall()\n"
"        for book_link in book_links:\n"
"            yield response.follow(book_link, self.parse_book)\n"
"\n"
"    def parse_book(self, response):\n"
"        yield {\n"
"            \"title\": response.css(\"h1::text\").get(),\n"
"            \"price\": response.css(\"p.price_color::text\").get(),\n"
"        }"
msgstr ""

#: ../../../topics/spiders.rst:378
msgid "This spider can be called from the command line::"
msgstr ""

#: ../../../topics/spiders.rst:380
msgid "scrapy crawl bookspider -a pages=2"
msgstr ""

#: ../../../topics/spiders.rst:385
msgid "Start requests"
msgstr ""

#: ../../../topics/spiders.rst:387
msgid ""
"**Start requests** are :class:`~scrapy.Request` objects yielded from the :"
"meth:`~scrapy.Spider.start` method of a spider or from the :meth:`~scrapy."
"spidermiddlewares.SpiderMiddleware.process_start` method of a :ref:`spider "
"middleware <topics-spider-middleware>`."
msgstr ""

#: ../../../topics/spiders.rst:392
msgid ":ref:`start-request-order`"
msgstr ""

#: ../../../topics/spiders.rst:397
msgid "Delaying start request iteration"
msgstr ""

#: ../../../topics/spiders.rst:399
msgid ""
"Scrapy iterates :meth:`~scrapy.Spider.start` as fast as it yields, so all "
"start requests reach the scheduler early in the crawl, however many they "
"are. To minimize the number of requests in the scheduler at any given time, "
"and with it resource usage (memory, or disk when using :setting:`JOBDIR`), "
"override :meth:`~scrapy.Spider.start` to pause its iteration whenever there "
"are scheduled requests:"
msgstr ""

#: ../../../topics/spiders.rst:406
msgid ""
"async def start(self):\n"
"    async for item_or_request in super().start():\n"
"        if self.crawler.engine.needs_backout():\n"
"            await self.crawler.signals.wait_for(signals.scheduler_empty)\n"
"        yield item_or_request"
msgstr ""

#: ../../../topics/spiders.rst:417
msgid "Handling start errors"
msgstr ""

#: ../../../topics/spiders.rst:419
msgid ""
"An exception raised by :meth:`~scrapy.Spider.start` ends its iteration, so "
"any remaining start items and requests are never sent. Scrapy logs the "
"exception, sends the :signal:`spider_error` signal, and, once the already "
"scheduled requests are done, closes the spider with the ``start_error`` :"
"stat:`finish_reason`."
msgstr ""

#: ../../../topics/spiders.rst:425
msgid ""
"The close reason used to be ``finished``, and neither the :signal:"
"`spider_error` signal nor the :stat:`spider_exceptions/count` stat reported "
"the exception."
msgstr ""

#: ../../../topics/spiders.rst:430
msgid "To keep the iteration going, catch the exception yourself:"
msgstr ""

#: ../../../topics/spiders.rst:432
msgid ""
"async def start(self):\n"
"    for url in self.start_urls:\n"
"        try:\n"
"            request = Request(url)\n"
"        except ValueError:\n"
"            self.logger.exception(f\"Skipping start URL {url}\")\n"
"        else:\n"
"            yield request"
msgstr ""

#: ../../../topics/spiders.rst:443
msgid ""
"To stop the crawl instead, and choose your own :stat:`finish_reason`, raise :"
"exc:`~scrapy.exceptions.CloseSpider`."
msgstr ""

#: ../../../topics/spiders.rst:449
msgid "Generic Spiders"
msgstr ""

#: ../../../topics/spiders.rst:451
msgid ""
"Scrapy comes with some useful generic spiders that you can use to subclass "
"your spiders from. Their aim is to provide convenient functionality for a "
"few common scraping cases, like following all links on a site based on "
"certain rules, crawling from `Sitemaps`_, or parsing an XML/CSV feed."
msgstr ""

#: ../../../topics/spiders.rst:456
msgid ""
"For the examples used in the following spiders, we'll assume you have a "
"project with a ``TestItem`` declared in a ``myproject.items`` module:"
msgstr ""

#: ../../../topics/spiders.rst:459
msgid ""
"from dataclasses import dataclass\n"
"\n"
"\n"
"@dataclass\n"
"class TestItem:\n"
"    id: str | None = None\n"
"    name: str | None = None\n"
"    description: str | None = None"
msgstr ""

#: ../../../topics/spiders.rst:474
msgid "CrawlSpider"
msgstr ""

#: ../../../topics/spiders.rst:478
msgid ""
"This is the most commonly used spider for crawling regular websites, as it "
"provides a convenient mechanism for following links by defining a set of "
"rules. It may not be the best suited for your particular web sites or "
"project, but it's generic enough for several cases, so you can start from it "
"and override it as needed for more custom functionality, or just implement "
"your own spider."
msgstr ""

#: ../../../topics/spiders.rst:484
msgid ""
"Apart from the attributes inherited from Spider (that you must specify), "
"this class supports a new attribute:"
msgstr ""

#: ../../../topics/spiders.rst:489
msgid ""
"Which is a list of one (or more) :class:`Rule` objects.  Each :class:`Rule` "
"defines a certain behaviour for crawling the site. Rules objects are "
"described below. If multiple rules match the same link, the first one will "
"be used, according to the order they're defined in this attribute."
msgstr ""

#: ../../../topics/spiders.rst:494
msgid "This spider also exposes an overridable method:"
msgstr ""

#: ../../../topics/spiders.rst:498
msgid ""
"This method is called for each response produced for the URLs in the "
"spider's ``start_urls`` attribute. It allows to parse the initial responses "
"and must return either an :ref:`item object <topics-items>`, a :class:"
"`~scrapy.Request` object, or an iterable containing any of them."
msgstr ""

#: ../../../topics/spiders.rst:505
msgid "Crawling rules"
msgstr ""

#: ../../../topics/spiders.rst:555
msgid "CrawlSpider example"
msgstr ""

#: ../../../topics/spiders.rst:557
msgid "Let's now take a look at an example CrawlSpider with rules:"
msgstr ""

#: ../../../topics/spiders.rst:559
msgid ""
"from scrapy.spiders import CrawlSpider, Rule\n"
"from scrapy.linkextractors import LinkExtractor\n"
"\n"
"\n"
"class MySpider(CrawlSpider):\n"
"    name = \"example.com\"\n"
"    allowed_domains = [\"example.com\"]\n"
"    start_urls = [\"http://www.example.com\"]\n"
"\n"
"    rules = (\n"
"        # Extract links matching 'category.php' (but not matching "
"'subsection.php')\n"
"        # and follow links from them (since no callback means follow=True by "
"default).\n"
"        Rule(LinkExtractor(allow=(r\"category\\.php\",), "
"deny=(r\"subsection\\.php\",))),\n"
"        # Extract links matching 'item.php' and parse them with the spider's "
"method parse_item\n"
"        Rule(LinkExtractor(allow=(r\"item\\.php\",)), "
"callback=\"parse_item\"),\n"
"    )\n"
"\n"
"    def parse_item(self, response):\n"
"        self.logger.info(\"Hi, this is an item page! %s\", response.url)\n"
"        item = {}\n"
"        item[\"id\"] = response.xpath('//td[@id=\"item_id\"]/text()')."
"re(r\"ID: (\\d+)\")\n"
"        item[\"name\"] = response.xpath('//td[@id=\"item_name\"]/text()')."
"get()\n"
"        item[\"description\"] = response.xpath(\n"
"            '//td[@id=\"item_description\"]/text()'\n"
"        ).get()\n"
"        item[\"link_text\"] = response.meta[\"link_text\"]\n"
"        url = response.xpath('//td[@id=\"additional_data\"]/@href').get()\n"
"        return response.follow(\n"
"            url, self.parse_additional_page, cb_kwargs=dict(item=item)\n"
"        )\n"
"\n"
"    def parse_additional_page(self, response, item):\n"
"        item[\"additional_data\"] = response.xpath(\n"
"            '//p[@id=\"additional_data\"]/text()'\n"
"        ).get()\n"
"        return item"
msgstr ""

#: ../../../topics/spiders.rst:599
msgid ""
"This spider would start crawling example.com's home page, collecting "
"category links, and item links, parsing the latter with the ``parse_item`` "
"method. For each item response, some data will be extracted from the HTML "
"using XPath, and a dictionary will be filled with it."
msgstr ""

#: ../../../topics/spiders.rst:605
msgid "XMLFeedSpider"
msgstr ""

#: ../../../topics/spiders.rst:609
msgid ""
"XMLFeedSpider is designed for parsing XML feeds by iterating through them by "
"a certain node name.  The iterator can be chosen from: ``iternodes``, "
"``xml``, and ``html``.  It's recommended to use the ``iternodes`` iterator "
"for performance reasons, since the ``xml`` and ``html`` iterators generate "
"the whole DOM at once in order to parse it.  However, using ``html`` as the "
"iterator may be useful when parsing XML with bad markup."
msgstr ""

#: ../../../topics/spiders.rst:616
msgid ""
"To set the iterator and the tag name, you must define the following class "
"attributes:"
msgstr ""

#: ../../../topics/spiders.rst:621
msgid "A string which defines the iterator to use. It can be either:"
msgstr ""

#: ../../../topics/spiders.rst:623
msgid "``'iternodes'`` - a fast iterator based on ``lxml``"
msgstr ""

#: ../../../topics/spiders.rst:625
msgid ""
"``'html'`` - an iterator which uses :class:`~scrapy.Selector`. Keep in mind "
"this uses DOM parsing and must load all DOM in memory which could be a "
"problem for big feeds. It also parses the feed with an HTML parser, which "
"can silently mangle tags that HTML treats as void elements, such as "
"``<link>``, dropping their content and closing tag. Use ``xml`` or "
"``iternodes`` instead for feeds affected by this."
msgstr ""

#: ../../../topics/spiders.rst:633
msgid ""
"``'xml'`` - an iterator which uses :class:`~scrapy.Selector`. Keep in mind "
"this uses DOM parsing and must load all DOM in memory which could be a "
"problem for big feeds"
msgstr ""

#: ../../../topics/spiders.rst:637
msgid "It defaults to: ``'iternodes'``."
msgstr ""

#: ../../../topics/spiders.rst:641
msgid "A string with the name of the node (or element) to iterate in. Example:"
msgstr ""

#: ../../../topics/spiders.rst:643
msgid "itertag = \"product\""
msgstr ""

#: ../../../topics/spiders.rst:649
msgid ""
"A list of ``(prefix, uri)`` tuples which define the namespaces available in "
"that document that will be processed with this spider. The ``prefix`` and "
"``uri`` will be used to automatically register namespaces using the :meth:"
"`~scrapy.Selector.register_namespace` method."
msgstr ""

#: ../../../topics/spiders.rst:655
msgid ""
"You can then specify nodes with namespaces in the :attr:`itertag` attribute."
msgstr ""

#: ../../../topics/spiders.rst:658
msgid "Example:"
msgstr ""

#: ../../../topics/spiders.rst:660
msgid ""
"from scrapy.spiders import XMLFeedSpider\n"
"\n"
"\n"
"class YourSpider(XMLFeedSpider):\n"
"\n"
"    namespaces = [(\"n\", \"http://www.sitemaps.org/schemas/sitemap/0.9\")]\n"
"    itertag = \"n:url\"\n"
"    # ..."
msgstr ""

#: ../../../topics/spiders.rst:671
msgid ""
"Apart from these new attributes, this spider has the following overridable "
"methods too:"
msgstr ""

#: ../../../topics/spiders.rst:676
msgid ""
"A method that receives the response as soon as it arrives from the spider "
"middleware, before the spider starts parsing it. It can be used to modify "
"the response body before parsing it. This method receives a response and "
"also returns a response (it could be the same or another one)."
msgstr ""

#: ../../../topics/spiders.rst:683
msgid ""
"This method is called for the nodes matching the provided tag name "
"(``itertag``).  Receives the response and an :class:`~scrapy.Selector` for "
"each node.  Overriding this method is mandatory. Otherwise, your spider "
"won't work.  This method must return an :ref:`item object <topics-items>`, "
"a :class:`~scrapy.Request` object, or an iterable containing any of them."
msgstr ""

#: ../../../topics/spiders.rst:693
msgid ""
"This method is called for each result (item or request) returned by the "
"spider, and it's intended to perform any last time processing required "
"before returning the results to the framework core, for example setting the "
"item IDs. It receives a list of results and the response which originated "
"those results. It must return a list of results (items or requests)."
msgstr ""

#: ../../../topics/spiders.rst:699
msgid ""
"Because of its internal implementation, you must explicitly set callbacks "
"for new requests when writing :class:`XMLFeedSpider`-based spiders; "
"unexpected behaviour can occur otherwise."
msgstr ""

#: ../../../topics/spiders.rst:705
msgid "XMLFeedSpider example"
msgstr ""

#: ../../../topics/spiders.rst:707
msgid "These spiders are pretty easy to use, let's have a look at one example:"
msgstr ""

#: ../../../topics/spiders.rst:710
msgid ""
"from scrapy.spiders import XMLFeedSpider\n"
"from myproject.items import TestItem\n"
"\n"
"\n"
"class MySpider(XMLFeedSpider):\n"
"    name = \"example.com\"\n"
"    allowed_domains = [\"example.com\"]\n"
"    start_urls = [\"http://www.example.com/feed.xml\"]\n"
"    iterator = \"iternodes\"  # This is actually unnecessary, since it's the "
"default value\n"
"    itertag = \"item\"\n"
"\n"
"    def parse_node(self, response, node):\n"
"        self.logger.info(\n"
"            \"Hi, this is a <%s> node!: %s\", self.itertag, \"\".join(node."
"getall())\n"
"        )\n"
"\n"
"        item = TestItem()\n"
"        item.id = node.xpath(\"@id\").get()\n"
"        item.name = node.xpath(\"name\").get()\n"
"        item.description = node.xpath(\"description\").get()\n"
"        return item"
msgstr ""

#: ../../../topics/spiders.rst:734
msgid ""
"Basically what we did up there was to create a spider that downloads a feed "
"from the given ``start_urls``, and then iterates through each of its "
"``item`` tags, prints them out, and stores some random data in an :class:"
"`~scrapy.Item`."
msgstr ""

#: ../../../topics/spiders.rst:739
msgid "CSVFeedSpider"
msgstr ""

#: ../../../topics/spiders.rst:743
msgid ""
"This spider is very similar to the XMLFeedSpider, except that it iterates "
"over rows, instead of nodes. The method that gets called in each iteration "
"is :meth:`parse_row`."
msgstr ""

#: ../../../topics/spiders.rst:749
msgid ""
"A string with the separator character for each field in the CSV file "
"Defaults to ``','`` (comma)."
msgstr ""

#: ../../../topics/spiders.rst:754
msgid ""
"A string with the enclosure character for each field in the CSV file "
"Defaults to ``'\"'`` (quotation mark)."
msgstr ""

#: ../../../topics/spiders.rst:759
msgid "A list of the column names in the CSV file."
msgstr ""

#: ../../../topics/spiders.rst:763
msgid ""
"Receives a response and a dict (representing each row) with a key for each "
"provided (or detected) header of the CSV file.  This spider also gives the "
"opportunity to override ``adapt_response`` and ``process_results`` methods "
"for pre- and post-processing purposes."
msgstr ""

#: ../../../topics/spiders.rst:769
msgid "CSVFeedSpider example"
msgstr ""

#: ../../../topics/spiders.rst:771
msgid ""
"Let's see an example similar to the previous one, but using a :class:"
"`CSVFeedSpider`:"
msgstr ""

#: ../../../topics/spiders.rst:775
msgid ""
"from scrapy.spiders import CSVFeedSpider\n"
"from myproject.items import TestItem\n"
"\n"
"\n"
"class MySpider(CSVFeedSpider):\n"
"    name = \"example.com\"\n"
"    allowed_domains = [\"example.com\"]\n"
"    start_urls = [\"http://www.example.com/feed.csv\"]\n"
"    delimiter = \";\"\n"
"    quotechar = \"'\"\n"
"    headers = [\"id\", \"name\", \"description\"]\n"
"\n"
"    def parse_row(self, response, row):\n"
"        self.logger.info(\"Hi, this is a row!: %r\", row)\n"
"\n"
"        item = TestItem()\n"
"        item.id = row[\"id\"]\n"
"        item.name = row[\"name\"]\n"
"        item.description = row[\"description\"]\n"
"        return item"
msgstr ""

#: ../../../topics/spiders.rst:800
msgid "SitemapSpider"
msgstr ""

#: ../../../topics/spiders.rst:804
msgid ""
"SitemapSpider allows you to crawl a site by discovering the URLs using "
"`Sitemaps`_."
msgstr ""

#: ../../../topics/spiders.rst:807
msgid ""
"It supports nested sitemaps and discovering sitemap urls from `robots.txt`_."
msgstr ""

#: ../../../topics/spiders.rst:812
msgid "A list of urls pointing to the sitemaps whose urls you want to crawl."
msgstr ""

#: ../../../topics/spiders.rst:814
msgid ""
"You can also point to a `robots.txt`_ and it will be parsed to extract "
"sitemap urls from it."
msgstr ""

#: ../../../topics/spiders.rst:819
msgid "A list of tuples ``(regex, callback)`` where:"
msgstr ""

#: ../../../topics/spiders.rst:821
msgid ""
"``regex`` is a regular expression to match urls extracted from sitemaps. "
"``regex`` can be either a str or a compiled regex object."
msgstr ""

#: ../../../topics/spiders.rst:824
msgid ""
"callback is the callback to use for processing the urls that match the "
"regular expression. ``callback`` can be a string (indicating the name of a "
"spider method) or a callable."
msgstr ""

#: ../../../topics/spiders.rst:828 ../../../topics/spiders.rst:854
#: ../../../topics/spiders.rst:874
msgid "For example:"
msgstr ""

#: ../../../topics/spiders.rst:830
msgid "sitemap_rules = [(\"/product/\", \"parse_product\")]"
msgstr ""

#: ../../../topics/spiders.rst:834
msgid ""
"Rules are applied in order, and only the first one that matches will be used."
msgstr ""

#: ../../../topics/spiders.rst:837
msgid ""
"If you omit this attribute, all urls found in sitemaps will be processed "
"with the ``parse`` callback."
msgstr ""

#: ../../../topics/spiders.rst:842
msgid ""
"A list of regexes of sitemap that should be followed. This is only for sites "
"that use `Sitemap index files`_ that point to other sitemap files."
msgstr ""

#: ../../../topics/spiders.rst:846
msgid "By default, all sitemaps are followed."
msgstr ""

#: ../../../topics/spiders.rst:850
msgid ""
"Specifies if alternate links for one ``url`` should be followed. These are "
"links for the same website in another language passed within the same "
"``url`` block."
msgstr ""

#: ../../../topics/spiders.rst:856
msgid ""
"<url>\n"
"    <loc>http://example.com/</loc>\n"
"    <xhtml:link rel=\"alternate\" hreflang=\"de\" href=\"http://example.com/"
"de\"/>\n"
"</url>"
msgstr ""

#: ../../../topics/spiders.rst:863
msgid ""
"With ``sitemap_alternate_links`` set, this would retrieve both URLs. With "
"``sitemap_alternate_links`` disabled, only ``http://example.com/`` would be "
"retrieved."
msgstr ""

#: ../../../topics/spiders.rst:867
msgid "Default is ``sitemap_alternate_links`` disabled."
msgstr ""

#: ../../../topics/spiders.rst:871
msgid ""
"This is a filter function that could be overridden to select sitemap entries "
"based on their attributes."
msgstr ""

#: ../../../topics/spiders.rst:876
msgid ""
"<url>\n"
"    <loc>http://example.com/</loc>\n"
"    <lastmod>2005-01-01</lastmod>\n"
"</url>"
msgstr ""

#: ../../../topics/spiders.rst:883
msgid ""
"We can define a ``sitemap_filter`` function to filter ``entries`` by date:"
msgstr ""

#: ../../../topics/spiders.rst:885
msgid ""
"from datetime import datetime\n"
"from scrapy.spiders import SitemapSpider\n"
"\n"
"\n"
"class FilteredSitemapSpider(SitemapSpider):\n"
"    name = \"filtered_sitemap_spider\"\n"
"    allowed_domains = [\"example.com\"]\n"
"    sitemap_urls = [\"http://example.com/sitemap.xml\"]\n"
"\n"
"    def sitemap_filter(self, entries):\n"
"        for entry in entries:\n"
"            date_time = datetime.strptime(entry[\"lastmod\"], \"%Y-%m-%d\")\n"
"            if date_time.year >= 2005:\n"
"                yield entry"
msgstr ""

#: ../../../topics/spiders.rst:902
msgid ""
"This would retrieve only ``entries`` modified on 2005 and the following "
"years."
msgstr ""

#: ../../../topics/spiders.rst:905
msgid ""
"Entries are dict objects extracted from the sitemap document. Usually, the "
"key is the tag name and the value is the text inside it."
msgstr ""

#: ../../../topics/spiders.rst:908
msgid "It's important to notice that:"
msgstr ""

#: ../../../topics/spiders.rst:910
msgid ""
"as the loc attribute is required, entries without this tag are discarded"
msgstr ""

#: ../../../topics/spiders.rst:911
msgid ""
"alternate links are stored in a list with the key ``alternate`` (see "
"``sitemap_alternate_links``)"
msgstr ""

#: ../../../topics/spiders.rst:913
msgid ""
"namespaces are removed, so lxml tags named as ``{namespace}tagname`` become "
"only ``tagname``"
msgstr ""

#: ../../../topics/spiders.rst:915
msgid ""
"If you omit this method, all entries found in sitemaps will be processed, "
"observing other attributes and their settings."
msgstr ""

#: ../../../topics/spiders.rst:920
msgid "SitemapSpider examples"
msgstr ""

#: ../../../topics/spiders.rst:922
msgid ""
"Simplest example: process all urls discovered through sitemaps using the "
"``parse`` callback:"
msgstr ""

#: ../../../topics/spiders.rst:925
msgid ""
"from scrapy.spiders import SitemapSpider\n"
"\n"
"\n"
"class MySpider(SitemapSpider):\n"
"    sitemap_urls = [\"http://www.example.com/sitemap.xml\"]\n"
"\n"
"    def parse(self, response):\n"
"        pass  # ... scrape item here ..."
msgstr ""

#: ../../../topics/spiders.rst:936
msgid ""
"Process some urls with certain callback and other urls with a different "
"callback:"
msgstr ""

#: ../../../topics/spiders.rst:939
msgid ""
"from scrapy.spiders import SitemapSpider\n"
"\n"
"\n"
"class MySpider(SitemapSpider):\n"
"    sitemap_urls = [\"http://www.example.com/sitemap.xml\"]\n"
"    sitemap_rules = [\n"
"        (\"/product/\", \"parse_product\"),\n"
"        (\"/category/\", \"parse_category\"),\n"
"    ]\n"
"\n"
"    def parse_product(self, response):\n"
"        pass  # ... scrape product ...\n"
"\n"
"    def parse_category(self, response):\n"
"        pass  # ... scrape category ..."
msgstr ""

#: ../../../topics/spiders.rst:957
msgid ""
"Follow sitemaps defined in the `robots.txt`_ file and only follow sitemaps "
"whose url contains ``/sitemap_shop``:"
msgstr ""

#: ../../../topics/spiders.rst:960
msgid ""
"from scrapy.spiders import SitemapSpider\n"
"\n"
"\n"
"class MySpider(SitemapSpider):\n"
"    sitemap_urls = [\"http://www.example.com/robots.txt\"]\n"
"    sitemap_rules = [\n"
"        (\"/shop/\", \"parse_shop\"),\n"
"    ]\n"
"    sitemap_follow = [\"/sitemap_shops\"]\n"
"\n"
"    def parse_shop(self, response):\n"
"        pass  # ... scrape shop here ..."
msgstr ""

#: ../../../topics/spiders.rst:975
msgid "Combine SitemapSpider with other sources of urls:"
msgstr ""

#: ../../../topics/spiders.rst:977
msgid ""
"from scrapy import Request\n"
"from scrapy.spiders import SitemapSpider\n"
"\n"
"\n"
"class MySpider(SitemapSpider):\n"
"    sitemap_urls = [\"http://www.example.com/robots.txt\"]\n"
"    sitemap_rules = [\n"
"        (\"/shop/\", \"parse_shop\"),\n"
"    ]\n"
"\n"
"    other_urls = [\"http://www.example.com/about\"]\n"
"\n"
"    async def start(self):\n"
"        async for item_or_request in super().start():\n"
"            yield item_or_request\n"
"        for url in self.other_urls:\n"
"            yield Request(url, self.parse_other)\n"
"\n"
"    def parse_shop(self, response):\n"
"        pass  # ... scrape shop here ...\n"
"\n"
"    def parse_other(self, response):\n"
"        pass  # ... scrape other here ..."
msgstr ""
